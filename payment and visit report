PROC SQL;
	CREATE TABLE RECEIPT AS 
	SELECT LTDE.COD_ACCT_NO,	   
		   CASE WHEN LTDE.REPAY_MODE IN (0,21) THEN "CASH" 
				WHEN LTDE.REPAY_MODE IN (1) THEN "CHEQUE" 
				WHEN LTDE.REPAY_MODE IN (6,7,8,9,12,13) THEN "ONLINE" 
	            ELSE "NO"
		   END AS INSTRUMENT_MODE,
           (LTDE.TOT_INSTLMNT_AMT + LTDE.AMT_SETTLEMENT) AS Allocated_Amount,
		   'Realized' as rcpt_stat,cod_rcpt_no as rcpt_no
	FROM PROD.ln_txn_dtls_ext LTDE 
	WHERE datepart(LTDE.dat_rcpt) = "&fortoday."D 
	AND LTDE.TOT_INSTLMNT_AMT > 0 
	AND LTDE.SETTLEMENT_MODE IN ('A','O','') 
/*	AND LTDE.FLG_REV_ALLOWED= "Y"*/
/*	AND LTDE.REV_FLAG = "N" */
	HAVING INSTRUMENT_MODE NOT IN ("NO");
QUIT;

PROC SQL;
	CREATE TABLE Receipt1 AS 
	SELECT cod_acct_no,sum(Allocated_Amount) AS ALLOCATED_AMOUNT 
	FROM RECEIPT 
	GROUP BY 1;
QUIT;

PROC SORT DATA=Receipt(KEEP=cod_acct_no Instrument_Mode rcpt_stat) OUT=Receipt2 NODUPKEY;
BY cod_acct_no;
RUN;

PROC SQL;
	CREATE TABLE Receipt3 AS 
	SELECT a.*,b.Instrument_Mode,B.rcpt_stat 
    FROM Receipt1 a 
	LEFT JOIN Receipt2 b ON a.COD_ACCT_NO = b.COD_ACCT_NO;
QUIT;

/* For Unrealized Cases */

PROC SQL;
	CREATE TABLE LXCR AS 
	SELECT COD_ACCT_NO,        
		   CASE WHEN cod_coll_mode = '0' THEN 'CASH' 
				WHEN cod_coll_mode = '1' THEN 'ICHQ' ELSE '' 
		        END AS INSTRUMENT_MODE,
		   amt_install_pre_emi_int as Allocated_Amount,
           CASE WHEN flg_repay_status = 'U' THEN 'Deposited' ELSE ''
           END AS rcpt_stat,coll_receipt_no as rcpt_no
	FROM PROD.LN_X_COLLECTION_REGISTER 
	WHERE datepart(dat_value) = "&fortoday."D
	HAVING rcpt_stat = "Deposited";
QUIT; 

PROC SQL;
	CREATE TABLE LXCR1 AS 
	SELECT cod_acct_no,sum(Allocated_Amount) AS ALLOCATED_AMOUNT 
	FROM LXCR GROUP BY 1;
QUIT;

PROC SORT DATA=LXCR(KEEP=cod_acct_no Instrument_Mode rcpt_stat) OUT=LXCR2 NODUPKEY;
BY cod_acct_no;
RUN;

PROC SQL;
	CREATE TABLE LXCR3 AS 
	SELECT a.*,b.Instrument_Mode,B.rcpt_stat 
    FROM LXCR1 a 
    LEFT JOIN LXCR2 b ON a.COD_ACCT_NO=b.COD_ACCT_NO;
QUIT;

PROC SQL;
	CREATE TABLE FINAL AS 
	SELECT * FROM Receipt3 UNION ALL SELECT * FROM LXCR3;
QUIT;

