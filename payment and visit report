			REPLACE;
RUN;

PROC SQL;
	CREATE TABLE LEVEL2 AS 
	SELECT L1.*,T.*,CATX(" - ",USER_NAME,MAKER_ID) AS EXECUTIVE_NAME,
           CASE WHEN COLLX_BKT = "a: 0 - 0"   THEN 1 WHEN COLLX_BKT = "b: 1 - 30"     THEN 2
				WHEN COLLX_BKT = "c: 31 - 60" THEN 3 WHEN COLLX_BKT = "d: 61 - 90" 	  THEN 4
				WHEN COLLX_BKT = "NPA" 	      THEN 5 WHEN COLLX_BKT = "Link Loan NPA" THEN 6
				WHEN COLLX_BKT = "AFS"	      THEN 7 ELSE 8 
   		   END AS COLLX_BKT_NEW
	FROM LEVEL1 L1 LEFT JOIN TIER T ON L1.LOAN_ID = T.LOAN_NO 
    WHERE T.TEAM IN ('Collection',"Collection-2");
QUIT;

PROC SORT DATA=LEVEL2 OUT=LEVEL3 DUPOUT=LEVEL4 NODUPKEY;BY LOAN_ID; RUN;

PROC SORT DATA=LEVEL3; BY COLLX_BKT_NEW;RUN;

PROC SQL;
	CREATE TABLE LEVEL5 AS
	SELECT compress(put(loan_id,20.)) as loan_no,maker_id AS employee_id,
		   user_name as Employee_name,EXECUTIVE_NAME,author_date,latitude,longitude,action_code, 
		   remarks,OP_DPD__Scale,Collx_Bkt, STATE, NH, Ticket, Team, ACM, 
		   ZH, Bkt as Bucket_Head, TL, Paid as Paid_status
	FROM LEVEL3;
QUIT;

PROC SQL;
CREATE TABLE BUCKET_WISE AS SELECT BKT,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY BKT ORDER BY COUNT DESC;
QUIT;

PROC SQL;
CREATE TABLE NH_WISE AS SELECT NH,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY NH ORDER BY COUNT DESC;
QUIT;

PROC SQL;
CREATE TABLE ZH_WISE AS SELECT ZH,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY ZH ORDER BY COUNT DESC;
QUIT;

PROC SQL;
CREATE TABLE ACM_WISE AS SELECT ACM,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY ACM ORDER BY COUNT DESC;
QUIT;

PROC SQL;
CREATE TABLE TL_WISE AS SELECT TL,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY TL ORDER BY COUNT DESC;
QUIT;

PROC SQL;
CREATE TABLE EXECUTIVE_WISE AS SELECT EXECUTIVE_NAME,COUNT(*) AS COUNT FROM LEVEL3 GROUP BY EXECUTIVE_NAME ORDER BY COUNT DESC;
QUIT;

PROC SQL;
	CREATE TABLE STATE_WISE AS 
	SELECT A.STATE,A.COUNT_TABLE1,B.COUNT_TABLE2 FROM 
	(SELECT STATE,COUNT(*) AS COUNT_TABLE1 FROM TIER WHERE PAID="Unpaid" 
	AND TEAM IN ('Collection',"Collection-2") GROUP BY STATE) A
	FULL JOIN 
	(SELECT STATE,COUNT(*) AS COUNT_TABLE2 FROM LEVEL3 WHERE PAID="Unpaid" GROUP BY STATE) B 
	ON A.STATE = B.STATE
	ORDER BY A.COUNT_TABLE1 DESC;
QUIT;

