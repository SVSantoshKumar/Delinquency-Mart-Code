PROC SQL;
	CREATE TABLE LEVEL1 AS 
    SELECT CFUT.LOAN_ID,CFUT.MAKER_ID,SUM.USER_NAME,CFUT.AUTHOR_DATE,CFUT.LATITUDE,CFUT.LONGITUDE,
		   CFUT.ACTION_CODE,CFUT.REMARKS 
	FROM DB.COLL_FOLLOW_UP_TRAILS CFUT
	LEFT JOIN DB.SEC_USER_M SUM ON CFUT.MAKER_ID = SUM.USER_ID 
	WHERE DATEPART(CFUT.AUTHOR_DATE) = "&today_date."d;
QUIT; 

OPTIONS VALIDVARNAME=v7;
