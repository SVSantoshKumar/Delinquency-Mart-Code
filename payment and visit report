PROC SQL;
	CREATE TABLE map_add AS
	SELECT R6.*,
	   	   MFDB.tmcurrentstatus,SUM(MFDB.Total_Due,MFDB.pre_emi) AS Total_Due,
           round(coalesce(MFDB.pos_cr,0.00),0.01) AS cr 
	FROM Receipt6 R6 
	LEFT JOIN DAILY.M_FINALDELIQUENCY_BASE MFDB ON R6.COD_ACCT_NO = COMPRESS(PUT(MFDB.LOAN_ID,20.))
	WHERE MFDB.tmcurrentstatus in ("3.Roll Back","4.Stable","");
QUIT;

