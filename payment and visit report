PROC SQL;
	CREATE TABLE RECEIPT_DELINQUENCY AS
	SELECT T1.cod_acct_no,T1.INSTRUMENT_MODE,T1.Allocated_Amount,T1.rcpt_stat as Receipt_Status,
	       SUM(MFDB.Total_Due,MFDB.pre_emi) AS Total_Due,ROUND(COALESCE(MFDB.pos_cr, 0), 0.01) AS CR
	FROM FINAL T1
	LEFT JOIN DAILY.M_FINALDELIQUENCY_BASE MFDB ON T1.COD_ACCT_NO = compress(PUT(MFDB.LOAN_ID,20.))
	WHERE MFDB.tmcurrentstatus IN ("5.Roll Forward","6.Cheque In Transit");
QUIT;

PROC SQL;
	CREATE TABLE map_tier AS
	SELECT a.*,b.* FROM RECEIPT_DELINQUENCY a
	LEFT JOIN TIER B ON a.cod_acct_no = COMPRESS(PUT(B.loan_no,20.)) 
    HAVING OP_DPD__Scale IS NOT NULL;
QUIT;

data map_tier1;
	set map_tier;
	if TOTAL_DUE <= ALLOCATED_AMOUNT THEN N_FLAG=1;
RUN; 

PROC SQL;
	CREATE TABLE MAP_TIER_1 AS 
	SELECT *,CASE WHEN COLLX_BKT = "a: 0 - 0"   	THEN 1
				  WHEN COLLX_BKT = "b: 1 - 30"      THEN 2
				  WHEN COLLX_BKT = "c: 31 - 60" 	THEN 3
				  WHEN COLLX_BKT = "d: 61 - 90" 	THEN 4
				  WHEN COLLX_BKT = "NPA" 	        THEN 5
				  WHEN COLLX_BKT = "Link Loan NPA"  THEN 6
				  WHEN COLLX_BKT = "NPA AFS"        THEN 7
			      WHEN COLLX_BKT = "AFS"      		THEN 8
				  ELSE 9 
                  END AS COLLX_BKT_NEW
	FROM MAP_TIER1;
QUIT;

PROC SORT DATA=MAP_TIER_1; BY COLLX_BKT_NEW;RUN; 

PROC SQL;
	CREATE TABLE map_tier2 AS 
	SELECT cod_acct_no AS New_loan_no,INSTRUMENT_MODE AS Instrument_Mode,
           Allocated_Amount AS Allocated_Amount,Total_Due, OP_DPD__Scale AS OP_DPD_Scale,Collx_Bkt,
		   cr AS Cr,Ticket, NH, Bkt AS Bucket_Head, Team, ACM, ZH_ AS ZH, _STATE AS State,
           Receipt_Status	
    FROM map_tier1
	ORDER BY cod_acct_no,OP_DPD__Scale,Collx_Bkt;
QUIT;

