CREATE OR REPLACE PROCEDURE DISHA_MART_ANALYTICS.COLLECTION_MART.LOAD_COLLECTION_BOUNCE_FINAL_TEST("RUN_MONTH" DATE DEFAULT CURRENT_DATE())
RETURNS VARCHAR(255)
LANGUAGE SQL
EXECUTE AS OWNER
AS 'DECLARE
        -- Logging Variables
    	PROC_NAME VARCHAR(500):=''DISHA_MART_ANALYTICS.COLLECTION_MART.LOAD_COLLECTION_BOUNCE_FINAL_TEST'';
    	TBL_NAME VARCHAR(500):=''DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST'';
        TOTAL_ROWS_IN_PREFINAL INTEGER;
        ROWS_INSERTED INTEGER DEFAULT 0;
        ROWS_UPDATED INTEGER DEFAULT 0;
        ROWS_UNCHANGED INTEGER DEFAULT 0;
        DUPLICATE_COUNT INTEGER;
        DUPLICATE_DETAILS VARCHAR(2000);
        CURR_TIME TIMESTAMP := TO_VARCHAR(CURRENT_TIMESTAMP());
        ERROR_MESSAGE VARCHAR(1000);
        FINAL_OUTPUT VARCHAR(4000);
        INSERT_COLUMN_LIST VARCHAR;
        INSERT_VALUE_LIST VARCHAR;
        INSERT_STATEMENT VARCHAR(16000);
		
    
	BEGIN
  
CREATE TABLE IF NOT EXISTS DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST
(
loan_no VARCHAR(255),
old_loan_no VARCHAR(255),
instrument_no VARCHAR(255),
deposit_bank_account VARCHAR(255),
instrument_mode VARCHAR(255),
instrument_amount VARCHAR(255) ,
allocated_amt VARCHAR(255),
received_date VARCHAR(255),
CYCLE VARCHAR(255),
instrument_date VARCHAR(255),
gross_status VARCHAR(255),
reason_for_bouncing VARCHAR(255),
STATUS_MAX VARCHAR(255),
STATUS_13 VARCHAR(255),
STATUS_18 VARCHAR(255),
STATUS_24 VARCHAR(255),
net_status VARCHAR(255),
MONTH VARCHAR(255),
gross_bounce VARCHAR(255),
net_bounce VARCHAR(255),
active_flag_new VARCHAR(255));

	



create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.base AS (
    SELECT
        loan_no,
		old_loan_no ,
		instrument_no ,
		deposit_bank_account ,
		instrument_mode ,
		instrument_amount  ,
		allocated_amt , 
		received_date ,
		CYCLE ,
		instrument_date ,
		gross_status ,
		reason_for_bouncing ,
		STATUS_MAX ,
		STATUS_13 ,
		STATUS_18 ,
		STATUS_24 ,
		MONTH ,
     	TRY_TO_DATE(instrument_date, ''DD-MM-YYYY'') AS inst_date
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_WITH_DUPLICATES_TEST
    WHERE month = :RUN_MONTH
);


--step 2 : Find the first instrument_date  

create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.first_attempt AS (
    SELECT *
    FROM (
        SELECT
            b.*,
            ROW_NUMBER() OVER (PARTITION BY loan_no, month ORDER BY inst_date) rn
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.base b
        where b.gross_status <> ''''
    )
    WHERE rn = 1
);




-- Step 3: Finding the cutoff date in accordance with cycle

create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff AS (
    SELECT
        f.*,
        CASE
          WHEN f.cycle = 5  THEN DATE_FROM_PARTS(YEAR(f.inst_date), MONTH(f.inst_date), 13)
          WHEN f.cycle = 10 THEN DATE_FROM_PARTS(YEAR(f.inst_date), MONTH(f.inst_date), 18)
          WHEN f.cycle = 15 THEN DATE_FROM_PARTS(YEAR(f.inst_date), MONTH(f.inst_date), 24)
          ELSE DATEADD(day,8,f.inst_date)
        END AS cutoff_date
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_attempt f
);




-- Step 4: Finding the loans whose repayment arrived next time

create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.subsequent AS (
    SELECT
        f.loan_no,
        f.old_loan_no,
        f.instrument_no,
        f.deposit_bank_account,
        f.instrument_mode,
        f.instrument_amount,
        f.allocated_amt,
        f.received_date,
        f.CYCLE,
        f.instrument_date,
        f.month,
        b.inst_date,
        b.gross_status,
        b.reason_for_bouncing,
        b.status_max,
        b.status_13,
        b.status_18,
        b.status_24,
        f.inst_date AS first_inst_date,
        f.cutoff_date
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff f
    JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.base b
      ON b.loan_no = f.loan_no
      AND b.instrument_amount = f.instrument_amount
     AND b.month   = f.month
     AND b.inst_date >= f.inst_date
     AND b.inst_date <= f.cutoff_date
);



--step 5  : Check which all loans has been bounced or passed based on cut off date

create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.pass_check AS (
    SELECT
        f.loan_no,
        f.old_loan_no,
        f.instrument_no ,
        f.deposit_bank_account ,
        f.instrument_mode ,
        f.instrument_amount  ,
        f.allocated_amt , 
        f.received_date ,
        f.cycle,
        f.instrument_date,
        f.gross_status,
        f.reason_for_bouncing,
        f.STATUS_MAX ,
		f.STATUS_13 ,
		f.STATUS_18 ,
		f.STATUS_24 ,
        f.month,
        MAX(
            CASE 
              WHEN s.gross_status = ''Realized'' THEN 1
             WHEN s.gross_status = ''Bounced'' and s.status_max = ''Realized'' THEN 1
              WHEN s.gross_status = ''Bounced''
                   AND s.status_max = ''Bounced'' AND (
                         (f.cycle = 5  AND COALESCE(s.status_13,''X'') NOT IN (''ROLLFORWARD'',''Cheque in transit''))
                      OR (f.cycle = 10 AND COALESCE(s.status_18,''X'') NOT IN (''ROLLFORWARD'',''Cheque in transit''))
                      OR (f.cycle = 15 AND COALESCE(s.status_24,''X'') NOT IN (''ROLLFORWARD'',''Cheque in transit''))
                   )
              THEN 1
              ELSE 0
            END
        ) AS has_pass
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff f
    LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.subsequent s
      ON f.loan_no = s.loan_no AND f.month = s.month
    GROUP BY f.loan_no, f.old_loan_no,f.instrument_no ,f.deposit_bank_account ,f.instrument_mode ,f.instrument_amount  ,f.allocated_amt , f.received_date ,
f.cycle,f.instrument_date,f.gross_status,f.reason_for_bouncing,f.STATUS_MAX ,
f.STATUS_13 ,f.STATUS_18 ,f.STATUS_24 , f.month
);







CREATE OR REPLACE TEMPORARY TABLE  DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST_PREFINAL 
(
loan_no VARCHAR(255),
old_loan_no VARCHAR(255),
instrument_no VARCHAR(255),
deposit_bank_account VARCHAR(255),
instrument_mode VARCHAR(255),
instrument_amount VARCHAR(255) ,
allocated_amt VARCHAR(255),
received_date VARCHAR(255),
CYCLE VARCHAR(255),
instrument_date VARCHAR(255),
gross_status VARCHAR(255),
reason_for_bouncing VARCHAR(255),
STATUS_MAX VARCHAR(255),
STATUS_13 VARCHAR(255),
STATUS_18 VARCHAR(255),
STATUS_24 VARCHAR(255),
net_status VARCHAR(255),
MONTH VARCHAR(255),
gross_bounce VARCHAR(255),
net_bounce VARCHAR(255),
active_flag_new VARCHAR(255) )
AS	
SELECT
    f.loan_no,
    f.old_loan_no,
        f.instrument_no ,
        f.deposit_bank_account ,
        f.instrument_mode ,
        f.instrument_amount  ,
        f.allocated_amt , 
        f.received_date ,
        f.cycle,
        f.instrument_date,
        f.gross_status,
        f.reason_for_bouncing,
        f.STATUS_MAX ,
		f.STATUS_13 ,
		f.STATUS_18 ,
		f.STATUS_24 ,   
    CASE
      WHEN f.gross_status = ''Realized'' THEN ''Pass''
      WHEN f.gross_status = ''Bounced''
           AND p.has_pass = 1 THEN ''Pass''
      ELSE ''Bounced''
    END AS net_status,
     f.month,
     CASE WHEN f.gross_status = ''Bounced'' then ''1'' else ''0'' END AS gross_bounce,
     CASE WHEN net_status = ''Bounced'' then ''1'' else ''0'' END AS net_bounce,
     ''1'' as active_flag_new     
FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff f
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.pass_check p
  ON f.loan_no = p.loan_no AND f.month = p.month AND f.cycle = p.cycle
ORDER BY f.loan_no, f.month ;





 -- Count total rows in prefinal table
        SELECT COUNT(*) INTO :TOTAL_ROWS_IN_PREFINAL
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST_PREFINAL;	
	
	
	-- Check for duplicates with details
        WITH DUPLICATE_CHECK AS (
            SELECT 
                loan_no ,instrument_no, instrument_mode,instrument_amount ,allocated_amt, received_date,instrument_date,gross_status,
				reason_for_bouncing,net_status,
                COUNT(*) AS RECORD_COUNTCOLLECTION_BOUNCE_FINAL_TEST_PREFINAL
            FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST_PREFINAL
            GROUP BY loan_no ,instrument_no, instrument_mode,instrument_amount ,allocated_amt, received_date,instrument_date,gross_status,reason_for_bouncing,net_status
            HAVING COUNT(*) > 1
        )
        SELECT COUNT(*) INTO :DUPLICATE_COUNT
        FROM DUPLICATE_CHECK;

 -- Insert column list (all columns including metadata columns)
        SELECT LISTAGG(COLUMN_NAME, '','')  WITHIN GROUP (ORDER BY ORDINAL_POSITION)
        INTO :INSERT_COLUMN_LIST
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = ''COLLECTION_MART''
        AND TABLE_NAME = ''COLLECTION_BOUNCE_FINAL_TEST_PREFINAL''
        AND TABLE_CATALOG = ''DISHA_MART_ANALYTICS'';
		
 -- Insert value list (dynamically mapping source columns)
        SELECT LISTAGG(''S.'' || COLUMN_NAME, '','')  WITHIN GROUP (ORDER BY ORDINAL_POSITION)
        INTO :INSERT_VALUE_LIST
        FROM DISHA_MART_ANALYTICS.INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = ''COLLECTION_MART''
        AND TABLE_NAME = ''COLLECTION_BOUNCE_FINAL_TEST_PREFINAL''
        AND TABLE_CATALOG = ''DISHA_MART_ANALYTICS'';  
		
 -- If duplicates exist, return detailed error
        IF (DUPLICATE_COUNT > 0) THEN
              SELECT CONCAT(
                ''===== DATA LOADING FAILED =====
    '',
                ''Total Rows in Prefinal: '', :TOTAL_ROWS_IN_PREFINAL, ''
    '',
                ''Duplicate Rows Found: '', :DUPLICATE_COUNT, ''
    '',
                ''ERROR: Unable to load data due to duplicate entries for LOAN_NO.'',''
    ''
            ) INTO :FINAL_OUTPUT;				
	
	--INSERT AUDIT INFO INTO TABLE
		DELETE FROM DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON 
		WHERE  PROCEDURE_NAME=:PROC_NAME
		AND	   EXECUTION_DATE=DATE(:CURR_TIME);
		
		INSERT INTO DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON
		(PROCEDURE_NAME, TABLE_NAME, EXECUTION_DATE, PREFINAL_CNT, INSERTED_CNT, UPDATED_CNT, UNCHANGED_CNT,STATUS,START_TIME,END_TIME)
		SELECT :PROC_NAME,:TBL_NAME,DATE(:CURR_TIME),:TOTAL_ROWS_IN_PREFINAL,:ROWS_INSERTED,:ROWS_UPDATED,:ROWS_UNCHANGED,''FAIL'',:CURR_TIME,CURRENT_TIMESTAMP;
			
        RETURN FINAL_OUTPUT;

        ELSE
		
		INSERT_STATEMENT:= 
    	CONCAT(''INSERT INTO DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST('',
    			INSERT_COLUMN_LIST,'')
    			SELECT '',
    			INSERT_VALUE_LIST,''
    			FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST_PREFINAL S;'');
    				
    	EXECUTE IMMEDIATE :INSERT_STATEMENT;	
		
             ROWS_INSERTED := (SELECT COUNT(*) FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_FINAL_TEST WHERE TO_DATE(instrument_date, ''DD-MM-YYYY'')=DATEADD(DAY,-1,TO_DATE(:RUN_MONTH)));
             ROWS_UPDATED := 0;
             ROWS_UNCHANGED := 0;
    	
		      -- Prepare detailed output
              SELECT CONCAT(
                ''===== DATA LOADING REPORT =====
    '',
                ''Process Timestamp: '', :CURR_TIME, ''
    '',
                ''Total Rows in Prefinal: '', :TOTAL_ROWS_IN_PREFINAL, ''
    '',
                ''Rows Inserted: '', :ROWS_INSERTED, ''
    '',
                ''Rows Updated: '', :ROWS_UPDATED, ''
    '',
                ''Rows Unchanged: '', :ROWS_UNCHANGED, ''
    
    '',
                ''
    
    '',
                ''Status: SUCCESSFULLY LOADED DATA INTO COLLECTION_BOUNCE_FINAL_TEST''
            ) INTO :FINAL_OUTPUT;
		
    		--INSERT AUDIT INFO INTO TABLE
    		DELETE FROM DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON 
    		WHERE  PROCEDURE_NAME=:PROC_NAME
    		AND	   EXECUTION_DATE=DATE(:CURR_TIME);
    		
    		INSERT INTO DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON
    		(PROCEDURE_NAME, TABLE_NAME, EXECUTION_DATE, PREFINAL_CNT, INSERTED_CNT, UPDATED_CNT, UNCHANGED_CNT,STATUS,START_TIME,END_TIME)
    		SELECT :PROC_NAME,:TBL_NAME,DATE(:CURR_TIME),:TOTAL_ROWS_IN_PREFINAL,:ROWS_INSERTED,:ROWS_UPDATED,:ROWS_UNCHANGED,''PASS'',:CURR_TIME,CURRENT_TIMESTAMP;
    		
    
            RETURN FINAL_OUTPUT;
        END IF;
    --EXCEPTION
    --    WHEN OTHER THEN
    --        -- Capture any unexpected errors
    --         ERROR_MESSAGE := SQLERRM;
    --        
    --        -- Prepare error output
    --          SELECT CONCAT(
    --            ''===== DATA LOADING FAILED =====
    --'',
    --            ''Error Timestamp: '', :CURR_TIME, ''
    --'',
    --            ''Total Rows in Prefinal: '', :TOTAL_ROWS_IN_PREFINAL, ''
    --'',
    --            ''ERROR MESSAGE: '', :ERROR_MESSAGE, ''
    --'',
    --            ''Status: UNEXPECTED ERROR DURING LOADING''
    --        ) INTO :FINAL_OUTPUT;
    
    --        RETURN FINAL_OUTPUT;
    END';
