    old_loan_no ,
    instrument_no ,
    deposit_bank_account ,
    instrument_mode ,
    instrument_amount  ,
    allocated_amt , 
    received_date ,
    CYCLE ,
    instrument_date ,
    gross_status ,
    reason_for_bouncing ,
    STATUS_MAX ,
    STATUS_13 ,
    STATUS_18 ,
    STATUS_24 ,
    MONTH ,
    '1' AS active_flag_new,
      TRY_TO_DATE(instrument_date, 'DD-MM-YYYY') AS inst_date
  FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_TEST1
  WHERE    
 month = '2025-07-01'
 );

 
