 -- pick the FIRST (earliest) instrument_date row per loan_no+month


create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.first_attempt AS (
  SELECT
    loan_no,
    old_loan_no ,
    instrument_no ,
    deposit_bank_account ,
    instrument_mode ,
    instrument_amount  ,
    allocated_amt , 
    received_date ,
    reason_for_bouncing ,
    STATUS_MAX ,
    STATUS_13 ,
    STATUS_18 ,
    STATUS_24 ,
    month,
    inst_date        AS first_inst_date,
    cycle            AS first_cycle,
    gross_status     AS first_gross_status
  FROM DISHA_MART_ANALYTICS.COLLECTION_MART.base
  QUALIFY ROW_NUMBER() OVER (PARTITION BY loan_no, month ORDER BY inst_date ASC) = 1
);

create or replace temp table DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff AS (
  SELECT
    f.*,
    CASE
      WHEN f.first_cycle = 5  THEN DATE_FROM_PARTS(YEAR(f.first_inst_date), MONTH(f.first_inst_date), 13)
      WHEN f.first_cycle = 10 THEN DATE_FROM_PARTS(YEAR(f.first_inst_date), MONTH(f.first_inst_date), 18)
      WHEN f.first_cycle = 15 THEN DATE_FROM_PARTS(YEAR(f.first_inst_date), MONTH(f.first_inst_date), 24)
      ELSE DATEADD(day, 8, f.first_inst_date)  -- fallback: 8-day window if cycle unexpected
    END AS cutoff_date
  FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_attempt f
);




SELECT
f.loan_no,
f.old_loan_no ,
f.instrument_no ,
f.deposit_bank_account ,
f.instrument_mode ,
f.instrument_amount  ,
f.first_inst_date as instrument_date,
f.allocated_amt , 
f.received_date ,
f.first_gross_status AS gross_status,
f.reason_for_bouncing ,
f.STATUS_MAX ,
f.STATUS_13 ,
f.STATUS_18 ,
f.STATUS_24 ,
f.month,
  CASE
    WHEN f.first_gross_status = 'Realized' THEN 'Pass'
    WHEN f.first_gross_status = 'Bounced'
         AND EXISTS (
           SELECT 1
           FROM DISHA_MART_ANALYTICS.COLLECTION_MART.base b
           WHERE b.loan_no = f.loan_no AND
                b.instrument_amount = f.instrument_amount
             AND b.month = f.month
             AND b.inst_date > f.first_inst_date
             AND b.inst_date <= f.cutoff_date
             AND b.gross_status = 'Realized'
         )
    THEN 'Pass'
    ELSE 'Bounced'
  END AS net_status
FROM DISHA_MART_ANALYTICS.COLLECTION_MART.first_with_cutoff f
ORDER BY f.loan_no, f.month;
