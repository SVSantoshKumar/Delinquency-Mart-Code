	CASE WHEN TOTAL_POS_AMOUNT = 0 then 0
	ELSE 
	(COALESCE(SUM(DISTINCT CASE WHEN a.OP_DPD > 0 and b.DPD = 0 THEN lps.total_pos_amt  END),0)) * 100/TOTAL_POS END AS NORMALIZATION_PERCENT,
CASE WHEN TOTAL_LOAN_COUNT = 0 then 0 
ELSE  
(paid_customer_count*100)/TOTAL_LOAN_COUNT END  AS RESOLUTION_PAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_PAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_UNPAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.VERTICAL = 'AFFORDABLE'  THEN a.loan_no END),0) AS AFFORDABLE_GRAND_TOTAL_COUNT,
COALESCE(
    COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' AND a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END) * 100.0 /
    NULLIF(COUNT(DISTINCT CASE WHEN a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END), 0),0) AS AFFORDABLE_RESOLUTION_PERCENT,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_NORMAL_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no  END),0) AS AFFORDABLE_STABLE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_ROLLFORWARD_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.STATUS = 'Cheque in transit' and a.VERTICAL = 'AFFORDABLE'   THEN a.loan_no END),0) AS AFFORDABLE_CHEQUE_IN_TRANSIT_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.WRITEOFF_LOAN = 1  THEN lps.total_pos_amt  END),0) AS WRITEOFF_TOTAL_POS,
NULL AS AFS_CLOSED_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1  THEN a.loan_no END),0) AS AFS_TOTAL_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'NORMAL'   THEN a.loan_no END),0) AS AFS_NORMAL_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'STABLE'  THEN a.loan_no END),0) AS AFS_CLEARANCE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'STABLE'  THEN a.loan_no END),0) AS AFS_STABLE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'RTD'  THEN a.loan_no END),0) AS AFS_RTD_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'ROLLBACK'  THEN a.loan_no END),0) AS AFS_ROLLBACK_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'ROLLFORWARD'  THEN a.loan_no END),0) AS AFS_ROLLFORWARD_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.STATUS = 'Cheque in transit'   THEN a.loan_no END),0) AS AFS_CHEQUE_IN_TRANSIT_COUNT, 
CASE WHEN AFS_TOTAL_COUNT = 0 then 0
	ELSE 
	(AFS_CLEARANCE_COUNT + AFS_NORMAL_COUNT + AFS_ROLLBACK_COUNT + AFS_STABLE_COUNT + AFS_RTD_COUNT ) * 100 /total_loan_count END AS AFS_RESOLUTION_PERCENT,
