	(MORATORIUM_MIS_CLEARANCE_MARK_COUNT + MORATORIUM_MIS_NORMAL_COUNT + MORATORIUM_MIS_ROLLBACK_COUNT + MORATORIUM_MIS_STABLE_COUNT + MORATORIUM_MIS_RTD_COUNT ) * 100 /TOTAL_MORATORIUM_COUNT END AS MORATORIUM_MIS_RESOLUTION_COUNT,
	CASE WHEN TOTAL_MORATORIUM_POS = 0 then 0
	ELSE 
	(MORATORIUM_MIS_CLEARANCE_MARK_POS + MORATORIUM_MIS_NORMAL_POS + MORATORIUM_MIS_ROLLBACK_POS + MORATORIUM_MIS_STABLE_POS + MORATORIUM_MIS_RTD_POS ) * 100 /TOTAL_MORATORIUM_POS END AS MORATORIUM_MIS_RESOLUTION_POS
FROM (select * from DISHA_MART_ANALYTICS.COLLECTION_MART.DELINQUENCY_MART WHERE TO_DATE(start_timestamp) <= '2024-09-10' 
  AND (TO_DATE(end_timestamp) > '2024-09-10' OR TO_DATE(end_timestamp) IS NULL)
)  a
INNER JOIN (
    SELECT * 
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST 
    WHERE extracted_date = '2024-09-10'
) b ON TRIM(a.loan_no) = TRIM(b.loan_no)
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.loan_pos_summary lps ON TRIM(a.loan_no) = TRIM(lps.loan_no)
left join 
(select * from DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE where TO_DATE(instrument_date,'dd-mm-yyyy') = '2024-09-10') d ON a.loan_no = d.loan_no 
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.bounce_summary bs on TRIM(a.loan_no) = TRIM(bs.loan_no)
   group by a.BRANCH_NAME,a.BRANCH_STATE,a.PRODUCT_NAME,a.PRODUCT_CATEGORY,a.VERTICAL, a.COLLECTION_AGENT_EMP_ID,
a.COLLECTION_RESPONSIBILITY,a.COLL_TL_EMP_ID,a.COLL_TL,a.COLL_ACM_EMP_ID,a.COLL_ACM,a.COLL_SH_EMP_ID,a.COLL_SH_NPL,a.COLL_ZH_EMP_ID,a.COLL_COLL_ZH,
a.COLL_AFFORDABLE_ACM_EMP_ID,a.COLL_AFFORDABLE_ACM,a.COLL_NH_EMP_ID,a.COLL_NH,a.COLL_BH_EMP_ID,a.COLL_BH,a.SALES_EMPLOYEE_ID,a.SALES_EMPLOYEE_NAME,
a.SALES_BSM_ID,a.SALES_BSM_NAME,a.SALES_PM_ID,a.SALES_PM_NAME,a.SALES_BH_ID,a.SALES_BH_NAME,a.SALES_SH_ID,a.SALES_SH_NAME,a.SALES_ZH_ID,a.SALES_ZH_NAME,
a.SALES_NSM_ID,a.SALES_NSM_NAME,a.SALES_VH_ID,a.SALES_VH_NAME,a.SALES_BSH_ID,a.SALES_BSH_NAME,a.CREDIT_ACM_ID,a.CREDIT_ACM_NAME,a.CREDIT_SCM_ID,
a.CREDIT_SCM_NAME,a.CREDIT_ZCM_ID,a.CREDIT_ZCM_NAME,a.CREDIT_ZCH_ID,a.CREDIT_ZCH_NAME,a.CREDIT_NCH_ID,a.CREDIT_NCH_NAME,a.TICKET
;
