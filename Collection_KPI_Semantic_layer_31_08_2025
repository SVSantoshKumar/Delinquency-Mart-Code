	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and b.DISBURSAL_STATUS = 'Partially Disbursed' THEN lps.total_pos_amt  END),0) AS pemi_stable_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN a.loan_no END),0) AS unpaid_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN lps.total_pos_amt  END),0) AS unpaid_customer_pos,	
