COALESCE(COUNT(DISTINCT CASE WHEN a.OP_DPD > 0 and a.OP_DPD <= 30 and  a.CURRENT_STATUS = 'ROLLBACK' THEN a.loan_no END),0)    AS    one_thirty_OP_DPD_ROLLBACK_LOAN_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.OP_DPD > 0 and a.OP_DPD <= 30 and  a.CURRENT_STATUS = 'STABLE' THEN a.loan_no END),0)      AS    one_thirty_OP_DPD_STABLE_LOAN_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.OP_DPD > 0 and a.OP_DPD <= 30 and  a.CURRENT_STATUS = 'RTD' THEN a.loan_no END),0) 	   	 AS    one_thirty_OP_DPD_RTD_LOAN_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.OP_DPD > 0 and a.OP_DPD <= 30 and  a.CURRENT_STATUS = 'ROLLFORWARD' THEN a.loan_no END),0) AS    one_thirty_OP_DPD_ROLLFORWARD_LOAN_COUNT,
