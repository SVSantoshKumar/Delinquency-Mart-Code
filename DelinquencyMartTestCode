CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.lad_deduped AS (
  SELECT *
  FROM (
    SELECT *
    FROM DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS
    WHERE activation_flag = 1
    QUALIFY ROW_NUMBER() OVER (PARTITION BY loan_no ORDER BY dat_start DESC) = 1
  )
);

