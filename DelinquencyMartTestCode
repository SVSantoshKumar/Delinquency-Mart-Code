CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.ch_dedup AS (
    SELECT *
    FROM (
        SELECT
				*,
            ROW_NUMBER() OVER (
                PARTITION BY NEW_LOAN_NO, EXTRACT_DT
                ORDER BY EXTRACT_DT DESC
            ) AS rn
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.ch_union_raw
    )
    WHERE rn = 1
);


CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.ch_effective AS (
    SELECT
       *,
        CASE
            WHEN EXTRACT_DT <= '2025-09-30'
                THEN DATE_TRUNC('MONTH', EXTRACT_DT) + INTERVAL '1 MONTH' - INTERVAL '1 DAY'
            ELSE EXTRACT_DT
        END AS EFFECTIVE_EXTRACT_DATE
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.ch_dedup
);




