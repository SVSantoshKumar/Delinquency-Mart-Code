CREATE OR REPLACE PROCEDURE DISHA_MART_ANALYTICS.COLLECTION_MART.LOAD_COLLECTION_DELINQUENCY_PAYMENT_STATUS("RUN_DATE" DATE DEFAULT CURRENT_DATE())
RETURNS VARCHAR(255)
LANGUAGE SQL
EXECUTE AS OWNER
AS 'DECLARE
        -- Logging Variables
    	PROC_NAME VARCHAR(500):=''DISHA_MART_ANALYTICS.COLLECTION_MART.LOAD_COLLECTION_DELINQUENCY_PAYMENT_STATUS'';
    	TBL_NAME VARCHAR(500):=''DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS'';
        TOTAL_ROWS_IN_PREFINAL INTEGER;
        ROWS_INSERTED INTEGER DEFAULT 0;
        ROWS_UPDATED INTEGER DEFAULT 0;
        ROWS_UNCHANGED INTEGER DEFAULT 0;
        DUPLICATE_COUNT INTEGER;
        DUPLICATE_DETAILS VARCHAR(20000);
        CURR_TIME TIMESTAMP := TO_VARCHAR(CURRENT_TIMESTAMP());
        ERROR_MESSAGE VARCHAR(10000);
        FINAL_OUTPUT VARCHAR;
        INSERT_COLUMN_LIST VARCHAR;
        INSERT_VALUE_LIST VARCHAR;
        INSERT_STATEMENT VARCHAR(32000);
		
    
	BEGIN
	
	DROP TABLE IF EXISTS DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS;

CREATE TABLE IF NOT EXISTS DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS
(
ACTUAL_DATE DATE,
BRANCH_NAME VARCHAR(255),
BRANCH_STATE VARCHAR(255),
TEAM VARCHAR(255), 
COLL_NH VARCHAR(255),
COLL_COLL_ZH VARCHAR(255),
COLL_AFFORDABLE_ACM VARCHAR(255),
OP_DPD VARCHAR(255) ,
CASH_COUNT INTEGER, 
CASH_SUM FLOAT,
CHEQUE_COUNT INTEGER,
CHEQUE_SUM FLOAT,
ONLINE_COUNT INTEGER,
ONLINE_SUM FLOAT,
HTS_COUNT INTEGER,
HTS_SUM FLOAT,
MTS_COUNT INTEGER,
MTS_SUM FLOAT,
SHTS_COUNT INTEGER,
SHTS_SUM FLOAT,
STS_COUNT INTEGER,
STS_SUM FLOAT,
TOTAL_PAYMENT_COUNT INTEGER,
TOTAL_PAYMENT_SUM FLOAT,
TOTAL_TICKET_COUNT INTEGER,
TOTAL_TICKET_SUM FLOAT
);



DROP TABLE IF EXISTS DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL;

CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL
(
ACTUAL_DATE DATE,
BRANCH_NAME VARCHAR(255),
BRANCH_STATE VARCHAR(255),
TEAM VARCHAR(255), 
COLL_NH VARCHAR(255),
COLL_COLL_ZH VARCHAR(255),
COLL_AFFORDABLE_ACM VARCHAR(255),
OP_DPD VARCHAR(255) ,
CASH_COUNT INTEGER, 
CASH_SUM FLOAT,
CHEQUE_COUNT INTEGER,
CHEQUE_SUM FLOAT,
ONLINE_COUNT INTEGER,
ONLINE_SUM FLOAT,
HTS_COUNT INTEGER,
HTS_SUM FLOAT,
MTS_COUNT INTEGER,
MTS_SUM FLOAT,
SHTS_COUNT INTEGER,
SHTS_SUM FLOAT,
STS_COUNT INTEGER,
STS_SUM FLOAT,
TOTAL_PAYMENT_COUNT INTEGER,
TOTAL_PAYMENT_SUM FLOAT,
TOTAL_TICKET_COUNT INTEGER,
TOTAL_TICKET_SUM FLOAT )
AS
SELECT  
  TO_DATE(:RUN_DATE) AS actual_date,
  BRANCH_NAME,
  BRANCH_STATE,
  TEAM,
  COLL_NH,
  COLL_COLL_ZH,
  COLL_AFFORDABLE_ACM,
    ODPD,
    
    -- CASH
    COUNT(CASE WHEN INSTRUMENT_MODE = ''CASH'' THEN 1 END) AS CASH_Count,
    SUM(CASE WHEN INSTRUMENT_MODE = ''CASH'' THEN Allocated_Amount ELSE 0 END) AS CASH_Sum,

    -- CHEQUE
    COUNT(CASE WHEN INSTRUMENT_MODE = ''CHEQUE'' THEN 1 END) AS CHEQUE_Count,
    SUM(CASE WHEN INSTRUMENT_MODE = ''CHEQUE'' THEN Allocated_Amount ELSE 0 END) AS CHEQUE_Sum,

    -- ONLINE
    COUNT(CASE WHEN INSTRUMENT_MODE = ''ONLINE'' THEN 1 END) AS ONLINE_Count,
    SUM(CASE WHEN INSTRUMENT_MODE = ''ONLINE'' THEN Allocated_Amount ELSE 0 END) AS ONLINE_Sum,

    --HTS
    COUNT(CASE WHEN TICKET = ''HTS'' THEN 1 END) AS HTS_Count,
    SUM(CASE WHEN TICKET = ''HTS'' THEN Allocated_Amount ELSE 0 END) AS HTS_Sum,
    --MTS
    COUNT(CASE WHEN TICKET = ''MTS'' THEN 1 END) AS MTS_Count,
    SUM(CASE WHEN TICKET = ''MTS'' THEN Allocated_Amount ELSE 0 END) AS MTS_Sum,
    --SHTS
    COUNT(CASE WHEN TICKET = ''SHTS'' THEN 1 END) AS SHTS_Count,
    SUM(CASE WHEN TICKET = ''SHTS'' THEN Allocated_Amount ELSE 0 END) AS SHTS_Sum,
    --STS
    COUNT(CASE WHEN TICKET = ''STS'' THEN 1 END) AS STS_Count,
    SUM(CASE WHEN TICKET = ''STS'' THEN Allocated_Amount ELSE 0 END) AS STS_Sum,

    -- TOTAL
    (CASH_Count + ONLINE_Count + CHEQUE_Count) AS TOTAL_PAYMENT_COUNT,
    (CHEQUE_Sum + ONLINE_Sum + CASH_Sum) AS TOTAL_PAYMENT_SUM,


    (HTS_Count + MTS_Count + SHTS_Count + STS_Count) AS TOTAL_TICKET_COUNT,
    (HTS_Sum + MTS_Sum + SHTS_Sum + STS_Sum) AS TOTAL_TICKET_SUM,
    

FROM (
    SELECT
        LTDE.COD_ACCT_NO,
        DM.BRANCH_NAME,
        DM.BRANCH_STATE,
        DM.TEAM AS TEAM,
        DM.COLL_NH,
        DM.COLL_COLL_ZH,
        DM.COLL_AFFORDABLE_ACM,
        CASE
            WHEN DM.OP_DPD = 0 THEN ''a: 0 - 0''
            WHEN DM.OP_DPD BETWEEN 1 AND 30 THEN ''b: 1 - 30''
            WHEN DM.OP_DPD BETWEEN 31 AND 60 THEN ''c: 31 - 60''
            WHEN DM.OP_DPD BETWEEN 61 AND 90 THEN ''d: 61 - 90''
            WHEN DM.OP_DPD BETWEEN 91 AND 120 THEN ''e: 91 - 120''
            WHEN DM.OP_DPD BETWEEN 121 AND 180 THEN ''f: 121 - 180''
            ELSE ''g: More Than 180''
        END AS ODPD,
        DM.TICKET AS TICKET,
        CASE 
            WHEN LTDE.REPAY_MODE IN (''0'',''21'') THEN ''CASH''
            WHEN LTDE.REPAY_MODE IN (''11'') THEN ''CHEQUE''
            WHEN LTDE.REPAY_MODE IN (''6'',''7'',''8'',''9'',''12'',''13'') THEN ''ONLINE''
            ELSE ''NO''
        END AS INSTRUMENT_MODE,

        (LTDE.TOT_INSTLMNT_AMT + LTDE.AMT_SETTLEMENT) AS Allocated_Amount

    FROM DISHA_L1_HARMONIZED.FLEX_LMS.LN_TXN_DTLS_EXT LTDE
    LEFT JOIN (
        SELECT * 
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.DELINQUENCY_MART 
        WHERE activation_flag = 1
    ) DM
    ON TRIM(LTDE.COD_ACCT_NO) = TRIM(DM.LOAN_NO)

    WHERE LTDE.TOT_INSTLMNT_AMT > 0
      AND LTDE.SETTLEMENT_MODE IN (''A'',''0'','''')
      AND DAT_RCPT = TO_DATE(CURRENT_DATE()) - 1
) SRC
GROUP BY 
BRANCH_NAME, BRANCH_STATE,TEAM, COLL_NH,COLL_COLL_ZH,COLL_AFFORDABLE_ACM,ODPD
ORDER BY 
BRANCH_NAME, BRANCH_STATE,TEAM, COLL_NH,COLL_COLL_ZH,COLL_AFFORDABLE_ACM, ODPD;

 -- Count total rows in prefinal table
        SELECT COUNT(*) INTO :TOTAL_ROWS_IN_PREFINAL
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL;	
	

-- Insert column list (all columns including metadata columns)
        SELECT LISTAGG(COLUMN_NAME, '','')  WITHIN GROUP (ORDER BY ORDINAL_POSITION)
        INTO :INSERT_COLUMN_LIST
        FROM INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = ''COLLECTION_MART''
        AND TABLE_NAME = ''COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL''
        AND TABLE_CATALOG = ''DISHA_MART_ANALYTICS'';
		
 -- Insert value list (dynamically mapping source columns)
        SELECT LISTAGG(''S.'' || COLUMN_NAME, '','')  WITHIN GROUP (ORDER BY ORDINAL_POSITION)
        INTO :INSERT_VALUE_LIST
        FROM DISHA_MART_ANALYTICS.INFORMATION_SCHEMA.COLUMNS
        WHERE TABLE_SCHEMA = ''COLLECTION_MART''
        AND TABLE_NAME = ''COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL''
        AND TABLE_CATALOG = ''DISHA_MART_ANALYTICS'';  
		
		
	
	--INSERT AUDIT INFO INTO TABLE
		DELETE FROM DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON 
		WHERE  PROCEDURE_NAME=:PROC_NAME
		AND	   EXECUTION_DATE=DATE(:CURR_TIME);
		
		INSERT INTO DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON
		(PROCEDURE_NAME, TABLE_NAME, EXECUTION_DATE, PREFINAL_CNT, INSERTED_CNT, UPDATED_CNT, UNCHANGED_CNT,STATUS,START_TIME,END_TIME)
		SELECT :PROC_NAME,:TBL_NAME,DATE(:CURR_TIME),:TOTAL_ROWS_IN_PREFINAL,:ROWS_INSERTED,:ROWS_UPDATED,:ROWS_UNCHANGED,''FAIL'',:CURR_TIME,CURRENT_TIMESTAMP;
			
        RETURN FINAL_OUTPUT; 

       -- ELSE
		*/
		INSERT_STATEMENT:= 
    	CONCAT(''INSERT INTO DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS('',
    			INSERT_COLUMN_LIST,'')
    			SELECT '',
    			INSERT_VALUE_LIST,''
    			FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS_PREFINAL S;'');
    				
    	EXECUTE IMMEDIATE :INSERT_STATEMENT;	
		
             ROWS_INSERTED := (SELECT COUNT(*) FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_DELINQUENCY_PAYMENT_STATUS WHERE actual_date=DATEADD(DAY,-1,TO_DATE(:RUN_DATE)));
             ROWS_UPDATED := 0;
             ROWS_UNCHANGED := 0;
    	
		      -- Prepare detailed output
              SELECT CONCAT(
         
                ''Total Rows in Prefinal: '', :TOTAL_ROWS_IN_PREFINAL, ''
    '',
                ''Rows Inserted: '', :ROWS_INSERTED, ''
    '',
                ''Rows Updated: '', :ROWS_UPDATED, ''
    '',
                ''Rows Unchanged: '', :ROWS_UNCHANGED, ''
    
    '',
      
                ''Status: SUCCESSFULLY LOADED DATA INTO COLLECTION_REPORT''
            ) INTO :FINAL_OUTPUT;
		
    		--INSERT AUDIT INFO INTO TABLE
    		DELETE FROM DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON 
    		WHERE  PROCEDURE_NAME=:PROC_NAME
    		AND	   EXECUTION_DATE=DATE(:CURR_TIME);
    		
    		INSERT INTO DISHA_MART_ANALYTICS.AUDIT_INFO.DAILY_COUNT_RECON
    		(PROCEDURE_NAME, TABLE_NAME, EXECUTION_DATE, PREFINAL_CNT, INSERTED_CNT, UPDATED_CNT, UNCHANGED_CNT,STATUS,START_TIME,END_TIME)
    		SELECT :PROC_NAME,:TBL_NAME,DATE(:CURR_TIME),:TOTAL_ROWS_IN_PREFINAL,:ROWS_INSERTED,:ROWS_UPDATED,:ROWS_UNCHANGED,''PASS'',:CURR_TIME,CURRENT_TIMESTAMP;
    		
    
            RETURN FINAL_OUTPUT;
        --END IF;
    --EXCEPTION
    --    WHEN OTHER THEN
    --        -- Capture any unexpected errors
    --         ERROR_MESSAGE := SQLERRM;
    --        
    --        -- Prepare error output
    --          SELECT CONCAT(
    --            ''''===== DATA LOADING FAILED =====
    --'''',
    --            ''''Error Timestamp: '''', :CURR_TIME, ''''
    --'''',
    --            ''''Total Rows in Prefinal: '''', :TOTAL_ROWS_IN_PREFINAL, ''''
    --'''',
    --            ''''ERROR MESSAGE: '''', :ERROR_MESSAGE, ''''
    --'''',
    --            ''''Status: UNEXPECTED ERROR DURING LOADING''''
    --        ) INTO :FINAL_OUTPUT;
    
    --        RETURN FINAL_OUTPUT;
    END';
