select new_ln_acct_no, count(*) from ns_max 
group by new_ln_acct_no having count(*) > 1
limit 1000



CREATE OR REPLACE TEMP TABLE ns_final AS
SELECT DISTINCT 
    a.loan_no,
	a.old_ln_acct_no,
	a.INSTR_NO,
	a.prtnr_bank_nam,
	a.INSTR_MODE,
    a.INSTR_AMT,
    a.ALLOCATED_AMT,
	a.INSTR_DAT,
	a.MAKER_DAT AS RECIEVED_DATE,
    a.cycle,
    b.status_min AS GROSS_STATUS,
    b.min_authordate,
    b.allocated_amt AS allocated_min,
    c.status_max,
    c.max_authordate,
    c.allocated_amt AS allocated_max
FROM kk a
LEFT JOIN ns_min b ON a.loan_no = b.new_ln_acct_no
LEFT JOIN ns_max c ON a.loan_no = c.new_ln_acct_no;
