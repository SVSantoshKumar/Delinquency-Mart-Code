CREATE OR REPLACE TEMP TABLE kk AS
SELECT 
    a.*,
	c.loan_no,
	b.cod_acct_no,
    SUBSTRING(TO_CHAR(b.cycle, 'YYYY-MM-DD'), 6, 2) AS cycle,
	TO_DATE(c.start_timestamp) as start_date,
	(c.end_timestamp) as end_date
FROM mode_filter1 a
LEFT JOIN (
    SELECT 
        cod_acct_no,
       -- MAX(DATE_TRUNC('day', dat_stage_end)) AS cycle
        MAX(DATE_TRUNC('day', TO_TIMESTAMP(dat_stage_end, 'YYYY-MM-DD HH24:MI:SS'))) AS CYCLE
    FROM DISHA_L1_HARMONIZED.FLEX_LMS.LN_ACCT_SCHEDULE
    WHERE nam_stage = 'EMI' and ACTIVATION_FLAG = 1 GROUP BY cod_acct_no
) b ON a.NEW_LN_ACCT_NO = b.cod_acct_no
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.DELIQUENCY_MART_V5 c
    ON TRIM(a.NEW_LN_ACCT_NO) = TRIM(c.loan_no) 
    where  TO_DATE(c.start_timestamp) <= '2024-10-05' and ( TO_DATE(c.end_timestamp) > '2024-10-05' OR  TO_DATE(c.end_timestamp) IS NULL)

select count(*) from kk limit 1000 -- 235628



CREATE OR REPLACE TEMP TABLE ns_min AS
SELECT *
FROM (
    SELECT 
        new_ln_acct_no,
		OLD_LN_ACCT_NO,
		INSTR_NO,
		prtnr_bank_nam,
		INSTR_MODE,
		INSTR_AMT,
		ALLOCATED_AMT,
		Rcpt_stat AS status_min,
        author_dat AS min_authordate,
		MAKER_DAT,
		INSTR_DAT,
		BOUNCE_REASON,
		start_date,
        ROW_NUMBER() OVER (PARTITION BY new_ln_acct_no ORDER BY author_dat ASC) AS rn
    FROM kk
    WHERE Rcpt_stat <> 'Cancelled'
)
QUALIFY rn = 1;


