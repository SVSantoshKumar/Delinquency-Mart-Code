create or replace TEMPORARY table  loan_pos_summary  AS
    SELECT 
        TRIM(loan_no) AS loan_no,
        SUM(total_pos) AS total_pos
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST
    WHERE extracted_date = '2024-08-04'
    GROUP BY TRIM(loan_no);






INSERT INTO DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_REPORT_V2
(
SELECT 
    '2024-08-02' AS actual_date,
	a.BRANCH_NAME AS BRANCH,
	a.BRANCH_STATE AS BRANCH_STATE,
	a.PRODUCT_NAME AS PRODUCT_NAME,
	a.PRODUCT_CATEGORY AS PRODUCT_BIFURCATION,
	a.VERTICAL AS VERTICAL,
	CONCAT(a.COLLECTION_AGENT_EMP_ID,a.COLLECTION_RESPONSIBILITY) AS COLL_HIERARCHY,
    COUNT(DISTINCT a.loan_no) AS TOTAL_LOAN_COUNT,
    sum(b.TOTAL_POS)/10000000 AS TOTAL_POS_IN_CR,
	CASE 
        WHEN sum(b.TOTAL_POS) = 0 THEN 0
        ELSE 
            SUM(CASE WHEN b.dpd > 0 THEN b.TOTAL_POS ELSE 0 END) * 100.0 /         sum(b.TOTAL_POS)
    END AS one_plus_percent_on_pos,
	NULL AS MONTH_OPENING_DPD,
	NULL AS MONTH_ENDING_DPD ,
	NULL AS MONTH_BEGINNING_TOTAL_DUE, 
	NULL AS MONTH_BEGINNING_PRINCIPAL_DUE, 
	NULL AS MONTH_BEGINNING_FEES_DUE, 
	NULL AS MONTH_BEGINNING_CHARGES_DUE, 
	NULL AS MONTH_PRINCIPAL_DUE_ADDED, 
	NULL AS MONTH_CHARGES_ADDED,
	NULL AS MONTH_PRINCIPAL_PAYMENTS_MADE,
	NULL AS MONTH_CHARGES_PAYMENTS_MADE,
	NULL AS MONTH_CLOSING_PRINCIPAL_DUE,
	NULL AS MONTH_CLOSING_CHARGES_DUE,
	NULL AS MONTH_PRINCIPAL_WRITE_OFF,
 	SUM(case when b.dpd > 90 then 1 else 0 END) AS NPA_COUNT,
	CASE 
        WHEN sum(b.TOTAL_POS) = 0 THEN 0
        ELSE 
			SUM(case when a.NPA_LOAN = 'NPA' then b.TOTAL_POS ELSE 0 END)/10000000 END AS npa_pos,
    	CASE 
        WHEN sum(b.TOTAL_POS) = 0 THEN 0
        ELSE 
			SUM(case when a.NPA_LOAN = 'NPA' then b.TOTAL_POS ELSE 0 END) * 100.0 / sum(b.TOTAL_POS) END AS NPA_PERCENT_ON_POS,
	NULL AS DIFF_POS_OP_FY_CURRENT_MONTH,		
	NULL AS DIFF_NPA_POS_OP_FY_CURRENT_MONTH,
	NULL AS BOUNCING_COUNT,
	NULL AS BOUNCING_PERCENT,
	NULL AS TOTAL_POS_NPL_WITH_RESOLUTION_PLAN, 
	COALESCE(COUNT(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'ON-BOOK' THEN a.loan_no END),0) AS total_on_book_loan_count,
    COALESCE(COUNT(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'OFF-BOOK' THEN a.loan_no END),0) AS total_off_book_loan_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'ON-BOOK' THEN b.total_pos END)/10000000,0) AS total_on_book_loan_pos,
    COALESCE(SUM(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'OFF-BOOK' THEN b.total_pos END)/10000000,0) AS total_off_book_loan_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN a.loan_no END),0) AS cheque_in_transit_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN b.total_pos END)/10000000,0) AS cheque_in_transit_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 0 THEN a.loan_no END),0) AS cleared_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 0 THEN b.total_pos END)/10000000,0) AS cleared_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' THEN b.total_pos END)/10000000,0) AS normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' THEN a.loan_no END),0) AS rollback_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' THEN b.total_pos END)/10000000,0) AS rollback_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' THEN a.loan_no  END),0) AS stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' THEN b.total_pos  END)/10000000,0) AS stable_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'RTD' THEN a.loan_no  END),0) AS rtd_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'RTD' THEN b.total_pos  END)/10000000,0) AS rtd_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' THEN a.loan_no  END),0) AS rollforward_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' THEN b.total_pos  END)/10000000,0) AS rollforward_customer_pos,
	(cleared_customer_count + normal_customer_count + rollback_customer_count + stable_customer_count + rtd_customer_count ) * 100 /total_loan_count AS RESOLUTION_COUNT_PERCENT,
	(cleared_customer_pos + normal_customer_pos + rollback_customer_pos + stable_customer_pos + rtd_customer_pos ) * 100 /TOTAL_POS_IN_CR AS RESOLUTION_POS_PERCENT,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Fully Disbursed' and a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS emi_normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and b.DISBURSAL_STATUS = 'Fully Disbursed' THEN b.total_pos END)/10000000,0) AS emi_normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Fully Disbursed' and a.CURRENT_STATUS = 'STABLE' THEN a.loan_no END),0) AS emi_stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and b.DISBURSAL_STATUS = 'Fully Disbursed' THEN b.total_pos END)/10000000,0) AS emi_stable_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Partially Disbursed' and a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS pemi_normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and b.DISBURSAL_STATUS = 'Partially Disbursed' THEN b.total_pos END)/10000000,0) AS pemi_normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Partially Disbursed' and a.CURRENT_STATUS = 'STABLE' THEN a.loan_no END),0) AS pemi_stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and b.DISBURSAL_STATUS = 'Partially Disbursed' THEN b.total_pos END)/10000000,0) AS pemi_stable_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN a.loan_no END),0) AS unpaid_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN b.total_pos END)/10000000,0) AS unpaid_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid'  THEN a.loan_no END),0) AS paid_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid'  THEN b.total_pos END)/10000000,0) AS paid_customer_pos,
NULL AS AS_ON_DATE_NORMAL, 
NULL AS NORMALIZATION_PERCENT,
NULL AS MAR_NORMAL_PERCENT,
NULL AS RESOLUTION_PAID_COUNT  ,
NULL AS MAR_XX_PERCENT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_PAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_UNPAID_COUNT,
NULL AS AFFORDABLE_GRAND_TOTAL_COUNT,
NULL AS AFFORDABLE_RESOLUTION_PERCENT,
NULL AS AFFORDABLE_NORMAL_COUNT,
NULL AS AFFORDABLE_STABLE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_ROLLFORWARD_COUNT, 
NULL AS AFFORDABLE_CHEQUE_IN_TRANSIT_COUNT, 
NULL AS AFS_CLOSED_COUNT,
NULL AS AFS_NORMAL_COUNT, 
NULL AS AFS_EMD_COUNT, 
NULL AS AFS_ROLLFORWARD_COUNT,  
NULL AS AFS_CHEQUE_IN_TRANSIT_COUNT, 
NULL AS AFS_RESOLUTION_PERCENT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and c.total_pos >= 2500000 THEN a.loan_no END),0) AS greater_than_25_LAC_POS_PAID_CASES, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid' and c.total_pos >= 2500000 THEN a.loan_no END),0) AS GREATER_THAN_25_LAC_POS_UNPAID_CASES,  
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD > 0 and a.OP_DPD > 0 and a.PENAL_AMOUNT_OUTSTANDING > 0 THEN a.loan_no END),0) AS TOTAL_PENAL_RECEIVED_LOAN_COUNT, 
NULL AS TOTAL_PENAL_LOAN_AMOUNT_RECEIVED, 
NULL AS PENAL_PERCENT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.loan_no END),0) AS Fully_Paid_Loans_DPD_0_AND_6_Plus_Instalments_Count, 
COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.PENAL_AMOUNT_OUTSTANDING END)/10000000,0) AS Penal_Outstanding_DPD_0_Fully_Paid_AND_6_Plus_Instalments, 
NULL AS Penal_Amount_Paid_DPD_0_Fully_Paid_AND_6_Plus_Instalments, 
NULL AS PENAL_RESOLUTION,  
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1  THEN b.total_pos END)/10000000,0) AS MORA_TOTAL_POS, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1  THEN b.loan_no END),0) AS MORA_UNPAID_COUNT, 
NULL AS MORA_UNPAID_POS, 
NULL AS MORATORIUM_MIS_NORMAL_COUNT,  
NULL AS MORATORIUM_MIS_NORMAL_POS, 
NULL AS MORATORIUM_MIS_CLEARANCE_MARK_COUNT, 
NULL AS MORATORIUM_MIS_CLEARANCE_MARK_POS, 
NULL AS MORATORIUM_MIS_STABLE_COUNT, 
NULL AS MORATORIUM_MIS_STABLE_POS, 
NULL AS MORATORIUM_MIS_ROLLFORWARD_COUNT, 
NULL AS MORATORIUM_MIS_ROLLFORWARD_POS, 
NULL AS MORATORIUM_MIS_CHQ_IN_TRANSIT_COUNT, 
NULL AS MORATORIUM_MIS_CHQ_IN_TRANSIT_POS, 
NULL AS MORATORIUM_MIS_RESOLUTION_COUNT,  
NULL AS MORATORIUM_MIS_RESOLUTION_POS 
		FROM DISHA_MART_ANALYTICS.COLLECTION_MART.DELIQUENCY_MART_V5 a
INNER JOIN loan_pos_summary c
ON TRIM(a.loan_no) = TRIM(c.loan_no)
INNER JOIN (
    SELECT * 
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST 
    WHERE extracted_date = '2024-08-02'
) b ON TRIM(a.loan_no) = TRIM(b.loan_no)
WHERE TO_DATE(a.start_timestamp) <= '2024-08-02' 
  AND (TO_DATE(a.end_timestamp) > '2024-08-02' OR TO_DATE(a.end_timestamp) IS NULL)
  group by a.BRANCH_NAME,a.BRANCH_STATE,a.COLLECTION_AGENT_EMP_ID,a.COLLECTION_RESPONSIBILITY,a.PRODUCT_NAME,a.PRODUCT_CATEGORY,a.VERTICAL
  );
  
  
  
 
