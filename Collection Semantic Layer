create or replace TEMPORARY table  DISHA_MART_ANALYTICS.COLLECTION_MART.loan_pos_summary  AS
    SELECT 
        TRIM(loan_no) AS loan_no,
        SUM(total_pos) AS total_pos_amt
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST
    WHERE extracted_date = TO_DATE(:RUN_DATE)
    GROUP BY TRIM(loan_no);


create or replace TEMPORARY table  DISHA_MART_ANALYTICS.COLLECTION_MART.bounce_summary AS
SELECT 
        loan_no,
        COUNT(*) AS bounce_count
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE
    WHERE UPPER(GROSS_STATUS) = ''BOUNCED''
    GROUP BY loan_no;
	


