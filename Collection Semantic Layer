create or replace TEMPORARY table  DISHA_MART_ANALYTICS.COLLECTION_MART.loan_pos_summary  AS
    SELECT 
        TRIM(loan_no) AS loan_no,
        SUM(total_pos) AS total_pos
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST
    WHERE extracted_date = '2024-08-04'
    GROUP BY TRIM(loan_no);


create or replace TEMPORARY table  DISHA_MART_ANALYTICS.COLLECTION_MART.Bounce_Count  AS
SELECT 
        loan_no,
        COUNT(*) AS bounce_count
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_V2
    WHERE UPPER(GROSS_STATUS) = 'Bounced'
    GROUP BY loan_no
);


INSERT INTO DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_REPORT_V2
(
SELECT 
    '2024-09-05' AS actual_date,
	a.BRANCH_NAME AS BRANCH,
	a.BRANCH_STATE AS BRANCH_STATE,
	a.PRODUCT_NAME AS PRODUCT_NAME,
	a.PRODUCT_CATEGORY AS PRODUCT_BIFURCATION,
	a.VERTICAL AS VERTICAL,
	CONCAT(a.COLLECTION_AGENT_EMP_ID,a.COLLECTION_RESPONSIBILITY) AS COLL_HIERARCHY,
    COUNT(DISTINCT a.loan_no) AS TOTAL_LOAN_COUNT,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DPD > 0 THEN a.loan_no END),0) AS one_plus_dpd_loan_count,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	one_plus_dpd_loan_count * 100/total_loan_count END AS one_plus_dpd_loan_count_percent,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DPD > 30 THEN a.loan_no END),0) AS thirty_plus_dpd_loan_count,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	thirty_plus_dpd_loan_count * 100/total_loan_count END AS thirty_plus_dpd_loan_count_percent,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DPD > 90 THEN a.loan_no END),0) AS ninety_plus_dpd_loan_count,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	ninety_plus_dpd_loan_count * 100/total_loan_count END AS ninety_plus_dpd_loan_count_percent,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DPD > 180 THEN a.loan_no END),0) AS one_eighty_plus_dpd_loan_count,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	one_eighty_plus_dpd_loan_count * 100/total_loan_count END AS one_eighty_plus_dpd_loan_count_percent,
    sum(lps.TOTAL_POS )/10000000 AS TOTAL_POS_IN_CR,
	COALESCE(SUM(DISTINCT CASE WHEN b.DPD > 0 THEN lps.TOTAL_POS  END)/10000000,0) AS one_plus_dpd_loan_amount,
	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
    ELSE 
    one_plus_dpd_loan_amount * 100.0 /sum(lps.TOTAL_POS )    END AS one_plus_dpd_loan_pos_percent,	
	COALESCE(SUM(DISTINCT CASE WHEN b.DPD > 30 THEN lps.TOTAL_POS  END)/10000000,0) AS thirty_plus_dpd_loan_amount,
	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
    ELSE 
	thirty_plus_dpd_loan_amount * 100.0 /sum(lps.TOTAL_POS ) END AS thirty_plus_dpd_loan_pos_percent,
	COALESCE(SUM(DISTINCT CASE WHEN b.DPD > 90 THEN lps.TOTAL_POS  END)/10000000,0) AS ninety_plus_dpd_loan_amount,
	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
    ELSE 
	ninety_plus_dpd_loan_amount * 100.0 /sum(lps.TOTAL_POS )    END AS ninety_plus_dpd_loan_pos_percent,
	COALESCE(SUM(DISTINCT CASE WHEN b.DPD > 180 THEN lps.TOTAL_POS  END)/10000000,0) AS one_eighty_plus_dpd_loan_amount,
	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
    ELSE 
	one_eighty_plus_dpd_loan_amount * 100.0 /sum(lps.TOTAL_POS ) END AS one_eighty_plus_dpd_loan_pos_percent,
	max(a.OPENING_MONTH_DPD) AS MONTH_OPENING_DPD,
	max(a.CLOSING_MONTH_DPD) AS MONTH_ENDING_DPD ,
	max(a.OPENING_TOTAL_DUE) AS MONTH_BEGINNING_TOTAL_DUE, 
	max(a.OPENING_PRINCIPAL_DUE) AS MONTH_BEGINNING_PRINCIPAL_DUE, 
	max(a.OPENING_CHARGES_DUE) AS MONTH_BEGINNING_CHARGES_DUE, 
	max(a.CLOSING_PRINCIPAL_DUE) AS MONTH_CLOSING_PRINCIPAL_DUE,
	max(a.CLOSING_CHARGES_DUE) AS MONTH_CLOSING_CHARGES_DUE,
 	SUM(case when b.dpd > 90 then 1 else 0 END) AS GROSS_NPA_COUNT,
	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
        ELSE 
			SUM(case when a.NPA_LOAN = 'NPA' then lps.TOTAL_POS  ELSE 0 END)/10000000 END AS gross_npa_pos,
    	CASE 
        WHEN sum(lps.TOTAL_POS ) = 0 THEN 0
        ELSE 
			SUM(case when a.NPA_LOAN = 'NPA' then lps.TOTAL_POS  ELSE 0 END) * 100.0 / sum(lps.TOTAL_POS ) END AS GROSS_NPA_PERCENT_ON_POS,
	COALESCE(COUNT(DISTINCT CASE WHEN UPPER(d.GROSS_STATUS) = 'Bounced' THEN a.loan_no END),0) AS GROSS_BOUNCE_COUNT,
	COALESCE(COUNT(DISTINCT CASE WHEN UPPER(d.NET_STATUS) = 'Bounced' THEN a.loan_no END),0) AS NET_BOUNCE_COUNT,
	COALESCE(GROSS_BOUNCE_COUNT + NET_BOUNCE_COUNT),0) AS TOTAL_BOUNCE_COUNT,
	COALESCE(SUM(DISTINCT CASE WHEN UPPER(d.GROSS_STATUS) = 'Bounced' THEN lps.TOTAL_POS  END)/10000000,0) AS GROSS_BOUNCE_AMOUNT,
	COALESCE(SUM(DISTINCT CASE WHEN UPPER(d.NET_STATUS) = 'Bounced' THEN lps.TOTAL_POS  END)/10000000,0) AS NET_BOUNCE_AMOUNT,	
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	GROSS_BOUNCE_COUNT * 100/total_loan_count END AS GROSS_BOUNCE_RATE,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	NET_BOUNCE_COUNT * 100/total_loan_count END AS NET_BOUNCE_RATE,
	COALESCE(COUNT(DISTINCT CASE WHEN bs.Bounce_Count = 1  THEN a.loan_no END),0) END AS FRESH_BOUNCE_CASES,
	COALESCE(COUNT(DISTINCT CASE WHEN bs.Bounce_Count > 1  THEN a.loan_no END),0) END AS REPEATED_BOUNCE_CASES,
	COALESCE(SUM(DISTINCT CASE WHEN (a.OP_DPD > 90 or a.AFS_LOAN = 1) and a.CURRENT_STATUS = 'NORMAL'   THEN lps.TOTAL_POS  END)/10000000,0) AS TOTAL_POS_NPL_WITH_RESOLUTION_PLAN, 
	COALESCE(COUNT(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'ON-BOOK' THEN a.loan_no END),0) AS total_on_book_loan_count,
    COALESCE(COUNT(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'OFF-BOOK' THEN a.loan_no END),0) AS total_off_book_loan_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'ON-BOOK' THEN lps.TOTAL_POS  END)/10000000,0) AS total_on_book_loan_pos,
    COALESCE(SUM(DISTINCT CASE WHEN a.ON_OFF_BOOK = 'OFF-BOOK' THEN lps.TOTAL_POS  END)/10000000,0) AS total_off_book_loan_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN a.loan_no END),0) AS cheque_in_transit_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN lps.TOTAL_POS  END)/10000000,0) AS cheque_in_transit_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN UPPER(d.GROSS_STATUS) = 'REALIZED' AND  UPPER(d.NET_STATUS) = 'PASS' and b.DPD = 0 and a.OP_DPD = 0 THEN a.loan_no END),0) AS cleared_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN UPPER(d.GROSS_STATUS) = 'REALIZED' AND UPPER(d.NET_STATUS) = 'PASS' AND b.DPD = 0 and a.OP_DPD = 0 THEN  lps.TOTAL_POS  END)/10000000,0) AS cleared_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' THEN lps.TOTAL_POS  END)/10000000,0) AS normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.BUCKET_HEAD = 'NPL' THEN a.loan_no END),0) AS npl_customer_count,
	CASE 
	WHEN total_loan_count = 0 then 0
	else
	npl_customer_count * 100/total_loan_count AS npl_customer_count_percent,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' THEN a.loan_no END),0) AS rollback_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'FLOW' THEN a.loan_no END),0) AS rollback_flow_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'GCL' THEN a.loan_no END),0) AS rollback_gcl_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'NPL' THEN a.loan_no END),0) AS rollback_npl_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' THEN lps.TOTAL_POS  END)/10000000,0) AS rollback_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'FLOW' THEN lps.TOTAL_POS  END)/10000000,0) AS rollback_flow_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'GCL' THEN lps.TOTAL_POS  END)/10000000,0) AS rollback_gcl_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.BUCKET_HEAD = 'NPL' THEN lps.TOTAL_POS  END)/10000000,0) AS rollback_npl_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' THEN a.loan_no  END),0) AS stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' THEN lps.TOTAL_POS   END)/10000000,0) AS stable_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'RTD' THEN a.loan_no  END),0) AS rtd_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'RTD' THEN lps.TOTAL_POS   END)/10000000,0) AS rtd_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' THEN a.loan_no  END),0) AS rollforward_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'FLOW' THEN a.loan_no  END),0) AS rollforward_flow_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'GCL' THEN a.loan_no  END),0) AS rollforward_gcl_customer_count,
	COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'NPL' THEN a.loan_no  END),0) AS rollforward_npl_customer_count,	
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' THEN lps.TOTAL_POS   END)/10000000,0) AS rollforward_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'FLOW'  THEN lps.TOTAL_POS   END)/10000000,0) AS rollforward_flow_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'GCL' THEN lps.TOTAL_POS   END)/10000000,0) AS rollforward_gcl_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.BUCKET_HEAD = 'NPL' THEN lps.TOTAL_POS   END)/10000000,0) AS rollforward_npl_customer_pos,
	CASE WHEN total_loan_count = 0 then 0
	ELSE 
	(cleared_customer_count + normal_customer_count + rollback_customer_count + stable_customer_count + rtd_customer_count ) * 100 /total_loan_count END AS RESOLUTION_COUNT_PERCENT,
	CASE 
	WHEN TOTAL_POS_IN_CR = 0 then 0
	ELSE 
	(cleared_customer_pos + normal_customer_pos + rollback_customer_pos + stable_customer_pos + rtd_customer_pos ) * 100 /TOTAL_POS_IN_CR END AS RESOLUTION_POS_PERCENT,
	COALESCE(COUNT(DISTINCT CASE WHEN a.BUCKET_HEAD = 'NPL'   THEN a.loan_no END),0) AS total_npl_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.BUCKET_HEAD = 'NPL'  THEN lps.TOTAL_POS  END)/10000000,0) AS total_npl_amount,
	CASE WHEN total_loan_count = 0 then 0
	ELSE 
	total_npl_count*100/total_loan_count END AS npl_percent,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Fully Disbursed' and a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS emi_normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and b.DISBURSAL_STATUS = 'Fully Disbursed' THEN lps.TOTAL_POS  END)/10000000,0) AS emi_normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Fully Disbursed' and a.CURRENT_STATUS = 'STABLE' THEN a.loan_no END),0) AS emi_stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and b.DISBURSAL_STATUS = 'Fully Disbursed' THEN lps.TOTAL_POS  END)/10000000,0) AS emi_stable_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Partially Disbursed' and a.CURRENT_STATUS = 'NORMAL' THEN a.loan_no END),0) AS pemi_normal_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and b.DISBURSAL_STATUS = 'Partially Disbursed' THEN lps.TOTAL_POS  END)/10000000,0) AS pemi_normal_customer_pos,
	COALESCE(COUNT(DISTINCT CASE WHEN b.DISBURSAL_STATUS = 'Partially Disbursed' and a.CURRENT_STATUS = 'STABLE' THEN a.loan_no END),0) AS pemi_stable_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and b.DISBURSAL_STATUS = 'Partially Disbursed' THEN lps.TOTAL_POS  END)/10000000,0) AS pemi_stable_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN a.loan_no END),0) AS unpaid_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid'  THEN lps.TOTAL_POS  END)/10000000,0) AS unpaid_customer_pos,	
	COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid'  THEN a.loan_no END),0) AS paid_customer_count,
	COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid'  THEN lps.TOTAL_POS  END)/10000000,0) AS paid_customer_pos,
	COALESCE(SUM(DISTINCT CASE WHEN a.OP_DPD != 0 and b.DPD = 0 THEN lps.TOTAL_POS  END)/10000000,0)  AS AS_ON_DATE_NORMAL, 
	CASE WHEN TOTAL_POS_IN_CR = 0 then 0
	ELSE 
	(COALESCE(SUM(DISTINCT CASE WHEN a.OP_DPD > 0 and b.DPD = 0 THEN lps.TOTAL_POS  END)/10000000,0)) * 100/TOTAL_POS_IN_CR END AS NORMALIZATION_PERCENT,
CASE WHEN TOTAL_LOAN_COUNT = 0 then 0 
ELSE  
(paid_customer_count*100)/TOTAL_LOAN_COUNT END  AS RESOLUTION_PAID_COUNT,
NULL AS MAR_XX_PERCENT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_PAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_UNPAID_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.VERTICAL = 'AFFORDABLE'  THEN a.loan_no END),0) AS AFFORDABLE_GRAND_TOTAL_COUNT,
COALESCE(
    COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' AND a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END) * 100.0 /
    NULLIF(COUNT(DISTINCT CASE WHEN a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END), 0),
0) AS AFFORDABLE_RESOLUTION_PERCENT,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_NORMAL_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no  END),0) AS AFFORDABLE_STABLE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.VERTICAL = 'AFFORDABLE' THEN a.loan_no END),0) AS AFFORDABLE_ROLLFORWARD_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.STATUS = 'Cheque in transit' and a.VERTICAL = 'AFFORDABLE'   THEN a.loan_no END),0) AS AFFORDABLE_CHEQUE_IN_TRANSIT_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.WRITEOFF_LOAN = 1  THEN lps.TOTAL_POS  END)/10000000,0) AS WRITEOFF_TOTAL_POS
NULL AS AFS_CLOSED_COUNT
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1  THEN a.loan_no END),0) AS AFS_TOTAL_COUNT,
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'NORMAL'   THEN a.loan_no END),0) AS AFS_NORMAL_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'STABLE'  THEN a.loan_no END),0) AS AFS_CLEARANCE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'STABLE'  THEN a.loan_no END),0) AS AFS_STABLE_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'RTD'  THEN a.loan_no END),0) AS AFS_RTD_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'ROLLBACK'  THEN a.loan_no END),0) AS AFS_ROLLBACK_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = 'ROLLFORWARD'  THEN a.loan_no END),0) AS AFS_ROLLFORWARD_COUNT,  
COALESCE(COUNT(DISTINCT CASE WHEN a.AFS_LOAN = 1 and a.STATUS = 'Cheque in transit'   THEN a.loan_no END),0) AS AFS_CHEQUE_IN_TRANSIT_COUNT, 
CASE WHEN AFS_TOTAL_COUNT = 0 then 0
	ELSE 
	(AFS_CLEARANCE_COUNT + AFS_NORMAL_COUNT + AFS_ROLLBACK_COUNT + AFS_STABLE_COUNT + AFS_RTD_COUNT ) * 100 /total_loan_count END AS AFS_RESOLUTION_PERCENT,
COALESCE(COUNT(DISTINCT CASE WHEN (UPPER(a.CURRENT_STATUS) = 'ROLLFORWARD' AND UPPER(d.GROSS_STATUS) = 'Bounced' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_rollforward_count,
COALESCE(COUNT(DISTINCT CASE WHEN UPPER(a.CURRENT_STATUS) = 'ROLLFORWARD' AND UPPER(d.GROSS_STATUS) = 'Bounced' and b.DPD > 90  THEN a.loan_no END),0) AS bouncing_90plus_rollforward_count,
COALESCE(COUNT(DISTINCT CASE WHEN (UPPER(a.STATUS) = 'Cheque in transit' AND UPPER(d.GROSS_STATUS) = 'Bounced' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_cheque_in_transit_count,
COALESCE(COUNT(DISTINCT CASE WHEN (a.PAID_STATUS = 'Paid' AND UPPER(d.GROSS_STATUS) = 'Bounced' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_paid_count,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS= 'STABLE' AND UPPER(d.GROSS_STATUS) = 'Bounced' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_stable_count,	
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and lps.total_pos >= 2500000 THEN a.loan_no END),0) AS greater_than_25_LAC_POS_PAID_CASES, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Unpaid' and lps.total_pos >= 2500000 THEN a.loan_no END),0) AS GREATER_THAN_25_LAC_POS_UNPAID_CASES,  
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD > 0 and a.OP_DPD > 0 and a.PENAL_AMOUNT_OUTSTANDING > 0 THEN a.loan_no END),0) AS TOTAL_PENAL_RECEIVED_LOAN_COUNT, 
COALESCE(COUNT(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.loan_no END),0) AS Fully_Paid_Loans_DPD_0_AND_6_Plus_Instalments_Count, 
COALESCE(SUM(DISTINCT CASE WHEN a.PAID_STATUS = 'Paid' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.PENAL_AMOUNT_OUTSTANDING END)/10000000,0) AS Penal_Outstanding_DPD_0_Fully_Paid_AND_6_Plus_Instalments, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1  THEN a.loan_no  END)/10000000,0) AS MORA_TOTAL_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1  THEN lps.TOTAL_POS  END)/10000000,0) AS MORA_TOTAL_POS, 
COALESCE(COUNT(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.PAID_STATUS = 'Unpaid' THEN a.loan_no END),0) AS MORA_UNPAID_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.PAID_STATUS = 'Unpaid' THEN lps.TOTAL_POS  END)/10000000,0) AS MORA_UNPAID_POS, 
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'NORMAL' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_NORMAL_COUNT,  
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = 'NORMAL' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_NORMAL_POS, 
COALESCE(COUNT(DISTINCT CASE WHEN a.MORATORIUM = 1 and UPPER(d.GROSS_STATUS) = 'REALIZED' AND  UPPER(d.NET_STATUS) = 'PASS' and b.DPD = 0 and a.OP_DPD = 0 THEN a.loan_no END),0) AS MORATORIUM_MIS_CLEARANCE_MARK_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and UPPER(d.GROSS_STATUS) = 'REALIZED' AND  UPPER(d.NET_STATUS) = 'PASS' and b.DPD = 0 and a.OP_DPD = 0 THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_CLEARANCE_MARK_POS, 
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'STABLE' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_STABLE_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = 'STABLE' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_STABLE_POS, 
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLFORWARD' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_ROLLFORWARD_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = 'ROLLFORWARD' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_ROLLFORWARD_POS,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'ROLLBACK' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_ROLLBACK_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = 'ROLLBACK' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_ROLLBACK_POS,
COALESCE(COUNT(DISTINCT CASE WHEN a.CURRENT_STATUS = 'RTD' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_RTD_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = 'RTD' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_RTD_POS,
 COALESCE(COUNT(DISTINCT CASE WHEN a.STATUS = 'Cheque in transit' and a.MORATORIUM = 1   THEN a.loan_no END),0) AS MORATORIUM_MIS_CHQ_IN_TRANSIT_COUNT, 
COALESCE(SUM(DISTINCT CASE WHEN a.MORATORIUM = 1 and a.STATUS = 'Cheque in transit' THEN lps.TOTAL_POS  END)/10000000,0) AS MORATORIUM_MIS_CHQ_IN_TRANSIT_POS, 
CASE WHEN MORA_TOTAL_COUNT = 0 then 0
	ELSE 
	(MORATORIUM_MIS_CLEARANCE_MARK_COUNT + MORATORIUM_MIS_NORMAL_COUNT + MORATORIUM_MIS_ROLLBACK_COUNT + MORATORIUM_MIS_STABLE_COUNT + MORATORIUM_MIS_RTD_COUNT ) * 100 /MORA_TOTAL_COUNT END AS MORATORIUM_MIS_RESOLUTION_COUNT,
	CASE WHEN MORA_TOTAL_POS = 0 then 0
	ELSE 
	(MORATORIUM_MIS_CLEARANCE_MARK_POS + MORATORIUM_MIS_NORMAL_POS + MORATORIUM_MIS_ROLLBACK_POS + MORATORIUM_MIS_STABLE_POS + MORATORIUM_MIS_RTD_POS ) * 100 /MORA_TOTAL_POS END AS MORATORIUM_MIS_RESOLUTION_POS
		FROM (select * from DISHA_MART_ANALYTICS.COLLECTION_MART.DELINQUENCY_MART_V7 WHERE TO_DATE(start_timestamp) <= '2024-09-05' 
  AND (TO_DATE(end_timestamp) > '2024-09-05' OR TO_DATE(end_timestamp) IS NULL)
)  a
INNER JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.loan_pos_summary lps
ON TRIM(a.loan_no) = TRIM(lps.loan_no)
INNER JOIN (
    SELECT * 
    FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST 
    WHERE extracted_date = '2024-09-05'
) b ON TRIM(a.loan_no) = TRIM(b.loan_no)
left join 
(select * from DISHA_MART_ANALYTICS.COLLECTION_MART.COLLECTION_BOUNCE_V2 where TO_DATE(instrument_date,'dd-mm-yyyy') = '2024-09-05' ) d ON a.loan_no = d.loan_no 
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.Bounce_Summary bs on TRIM(a.loan_no) = TRIM(b.loan_no)
   group by a.BRANCH_NAME,a.BRANCH_STATE,a.COLLECTION_AGENT_EMP_ID,a.COLLECTION_RESPONSIBILITY,a.PRODUCT_NAME,a.PRODUCT_CATEGORY,a.VERTICAL
);

    







 
 
 
 
