    TO_DATE(:RUN_DATE) AS actual_date,
	a.BRANCH_NAME AS BRANCH,
	a.BUSINESS_BRANCH AS BUSINESS_BRANCH,
	a.BRANCH_STATE AS BRANCH_STATE,
	a.BUSINESS_STATE AS BUSINESS_STATE,
	a.PRODUCT_NAME AS PRODUCT_NAME,
	a.PRODUCT_CATEGORY AS PRODUCT_BIFURCATION,
	a.VERTICAL AS VERTICAL,
	a.TEAM AS COLLECTION_TEAM,
	CONCAT(a.COLLECTION_AGENT_EMP_ID,'' '',a.COLLECTION_RESPONSIBILITY) AS COLL_AGENT,
	CONCAT(a.COLL_TL_EMP_ID,'' '',a.COLL_TL) AS COLL_TL,
	CONCAT(a.COLL_ACM_EMP_ID,'' '',a.COLL_ACM) AS COLL_ACM,
	CONCAT(a.COLL_SH_EMP_ID,'' '',a.COLL_SH_NPL) AS COLL_SH,
	CONCAT(a.COLL_ZH_EMP_ID,'' '',a.COLL_COLL_ZH) AS COLL_ZH,
	CONCAT(a.COLL_AFFORDABLE_ACM_EMP_ID,'' '',a.COLL_AFFORDABLE_ACM) AS COLL_AFFORDABLE_ACM,
	CONCAT(a.COLL_NH_EMP_ID,'' '',a.COLL_NH) AS COLL_NH,
	CONCAT(a.COLL_BH_EMP_ID,'' '',a.COLL_BH) AS COLL_BH,
	a.TICKET AS TICKET,
    COUNT(a.loan_no) AS TOTAL_LOAN_COUNT,
	COALESCE(COUNT( CASE WHEN b.DPD > 0 THEN a.loan_no END),0) AS one_plus_dpd_loan_count,
	COALESCE(COUNT( CASE WHEN b.DPD > 30 THEN a.loan_no END),0) AS thirty_plus_dpd_loan_count,
    COALESCE(COUNT( CASE WHEN b.DPD > 60 THEN a.loan_no END),0) AS SIXTY_PLUS_DPD_LOAN_COUNT,
    COALESCE(COUNT( CASE WHEN b.DPD > 90 THEN a.loan_no END),0) AS ninety_plus_dpd_loan_count,
	COALESCE(COUNT( CASE WHEN b.DPD > 180 THEN a.loan_no END),0) AS one_eighty_plus_dpd_loan_count,
	sum(lps.total_pos_amt ) AS TOTAL_POS_AMOUNT,
	COALESCE(SUM( CASE WHEN b.DPD > 0 THEN lps.total_pos_amt  END),0) AS one_plus_dpd_loan_pos,
	COALESCE(SUM( CASE WHEN b.DPD > 30 THEN lps.total_pos_amt  END),0) AS thirty_plus_dpd_loan_pos,
	COALESCE(SUM( CASE WHEN b.DPD > 60 THEN lps.total_pos_amt  END),0) AS sixty_plus_dpd_loan_pos,
		COALESCE(SUM( CASE WHEN b.DPD > 90 THEN lps.total_pos_amt  END),0) AS ninety_plus_dpd_loan_pos,
	COALESCE(SUM( CASE WHEN b.DPD > 180 THEN lps.total_pos_amt  END),0) AS one_eighty_plus_dpd_loan_pos,
	COALESCE(COUNT( CASE WHEN a.REPORTED_DPD > 90 THEN a.loan_no END),0) AS GROSS_NPA_COUNT,
	CASE 
        WHEN sum(lps.total_pos_amt ) = 0 THEN 0
        ELSE 
			SUM(case when a.REPORTED_DPD > 90 then lps.total_pos_amt  ELSE 0 END) END AS gross_npa_pos,
    COALESCE(COUNT( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''ON-BOOK'' THEN a.loan_no END),0) AS GROSS_NPA_ON_BOOK_COUNT,
	COALESCE(COUNT( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''OFF-BOOK'' THEN a.loan_no END),0) AS GROSS_NPA_OFF_BOOK_COUNT,
	COALESCE(COUNT( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''PTC'' THEN a.loan_no END),0) AS GROSS_NPA_PTC_BOOK_COUNT,
	COALESCE(SUM( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''ON-BOOK'' THEN lps.total_pos_amt  END),0) AS GROSS_NPA_ON_BOOK_AMOUNT,
    COALESCE(SUM( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''OFF-BOOK'' THEN lps.total_pos_amt  END),0) AS GROSS_NPA_OFF_BOOK_AMOUNT,
    COALESCE(SUM( CASE WHEN a.REPORTED_DPD > 90 and a.ON_OFF_BOOK = ''PTC'' THEN lps.total_pos_amt  END),0) AS GROSS_NPA_PTC_AMOUNT,
	COALESCE(COUNT( CASE WHEN UPPER(d.GROSS_STATUS) = ''BOUNCED'' THEN a.loan_no END),0) AS GROSS_BOUNCE_COUNT,
	COALESCE(COUNT( CASE WHEN UPPER(d.NET_STATUS) = ''BOUNCED'' THEN a.loan_no END),0) AS NET_BOUNCE_COUNT,
	COALESCE(SUM( CASE WHEN UPPER(d.GROSS_STATUS) = ''BOUNCED'' THEN lps.total_pos_amt  END),0) AS GROSS_BOUNCE_AMOUNT,
	COALESCE(SUM( CASE WHEN UPPER(d.NET_STATUS) = ''BOUNCED'' THEN lps.total_pos_amt  END),0) AS NET_BOUNCE_AMOUNT,	
	COALESCE(COUNT( CASE WHEN bs.bounce_count = 1  THEN a.loan_no END),0)  AS FRESH_BOUNCE_CASES,
	COALESCE(COUNT( CASE WHEN bs.bounce_count > 1  THEN a.loan_no END),0)  AS REPEATED_BOUNCE_CASES,
	COALESCE(SUM( CASE WHEN (a.OP_DPD > 90 or a.AFS_LOAN = 1) and a.CURRENT_STATUS = ''NORMAL''   THEN lps.total_pos_amt  END),0) AS TOTAL_POS_NPL_WITH_RESOLUTION_PLAN, 
	COALESCE(COUNT( CASE WHEN a.ON_OFF_BOOK = ''ON-BOOK'' THEN a.loan_no END),0) AS on_book_loan_count,
    COALESCE(COUNT( CASE WHEN a.ON_OFF_BOOK = ''OFF-BOOK'' THEN a.loan_no END),0) AS off_book_loan_count,
	COALESCE(SUM( CASE WHEN a.ON_OFF_BOOK = ''ON-BOOK'' THEN lps.total_pos_amt  END),0) AS on_book_loan_pos,
    COALESCE(SUM( CASE WHEN a.ON_OFF_BOOK = ''OFF-BOOK'' THEN lps.total_pos_amt  END),0) AS off_book_loan_pos,
	COALESCE(COUNT( CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN a.loan_no END),0) AS cheque_in_transit_customer_count,
	COALESCE(SUM( CASE WHEN a.CHEQUE_IN_TRANSIT_COUNT = 1 THEN lps.total_pos_amt  END),0) AS cheque_in_transit_customer_pos,
	COALESCE(COUNT( CASE WHEN UPPER(d.GROSS_STATUS) = ''REALIZED'' AND  UPPER(d.NET_STATUS) = ''PASS'' and b.DPD = 0 and a.OP_DPD = 0 THEN a.loan_no END),0) AS cleared_customer_count,
	COALESCE(SUM( CASE WHEN UPPER(d.GROSS_STATUS) = ''REALIZED'' AND UPPER(d.NET_STATUS) = ''PASS'' AND b.DPD = 0 and a.OP_DPD = 0 THEN  lps.total_pos_amt  END),0) AS cleared_customer_pos,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' THEN a.loan_no END),0) AS normal_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' THEN lps.total_pos_amt  END),0) AS normal_customer_pos,
	COALESCE(COUNT( CASE WHEN a.BUCKET_HEAD = ''NPL'' THEN a.loan_no END),0) AS npl_customer_count,
	COALESCE(SUM( CASE WHEN a.BUCKET_HEAD = ''NPL'' THEN lps.total_pos_amt  END),0) AS npl_customer_amount,	
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' THEN a.loan_no END),0) AS rollback_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''FLOW'' THEN a.loan_no END),0) AS rollback_flow_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''GCL'' THEN a.loan_no END),0) AS rollback_gcl_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''NPL'' THEN a.loan_no END),0) AS rollback_npl_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' THEN lps.total_pos_amt END),0) AS rollback_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''FLOW'' THEN lps.total_pos_amt  END),0) AS rollback_flow_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''GCL'' THEN lps.total_pos_amt  END),0) AS rollback_gcl_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.BUCKET_HEAD = ''NPL'' THEN lps.total_pos_amt  END),0) AS rollback_npl_customer_pos,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''STABLE'' THEN a.loan_no  END),0) AS stable_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''STABLE'' THEN lps.total_pos_amt   END),0) AS stable_customer_pos,	
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''RTD'' THEN a.loan_no  END),0) AS rtd_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''RTD'' THEN lps.total_pos_amt   END),0) AS rtd_customer_pos,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' THEN a.loan_no  END),0) AS rollforward_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''FLOW'' THEN a.loan_no  END),0) AS rollforward_flow_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''GCL'' THEN a.loan_no  END),0) AS rollforward_gcl_customer_count,
	COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''NPL'' THEN a.loan_no  END),0) AS rollforward_npl_customer_count,	
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' THEN lps.total_pos_amt   END),0) AS rollforward_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''FLOW''  THEN lps.total_pos_amt   END),0) AS rollforward_flow_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''GCL'' THEN lps.total_pos_amt END),0) AS rollforward_gcl_customer_pos,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.BUCKET_HEAD = ''NPL'' THEN lps.total_pos_amt END),0) AS rollforward_npl_customer_pos,
	CASE WHEN total_loan_count = 0 then 0
	ELSE 
	(cleared_customer_count + normal_customer_count + rollback_customer_count + stable_customer_count + rtd_customer_count ) * 100 /total_loan_count END AS RESOLUTION_COUNT_PERCENT,
	CASE 
	WHEN TOTAL_POS_AMOUNT = 0 then 0
	ELSE 
	(cleared_customer_pos + normal_customer_pos + rollback_customer_pos + stable_customer_pos + rtd_customer_pos ) * 100 /TOTAL_POS_AMOUNT END AS RESOLUTION_POS_PERCENT,
	COALESCE(COUNT( CASE WHEN b.DISBURSAL_STATUS = ''Fully Disbursed'' and a.CURRENT_STATUS = ''NORMAL'' THEN a.loan_no END),0) AS emi_normal_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' and b.DISBURSAL_STATUS = ''Fully Disbursed'' THEN lps.total_pos_amt  END),0) AS emi_normal_customer_pos,
	COALESCE(COUNT( CASE WHEN b.DISBURSAL_STATUS = ''Fully Disbursed'' and a.CURRENT_STATUS = ''STABLE'' THEN a.loan_no END),0) AS emi_stable_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''STABLE'' and b.DISBURSAL_STATUS = ''Fully Disbursed'' THEN lps.total_pos_amt  END),0) AS emi_stable_customer_pos,
	COALESCE(COUNT( CASE WHEN b.DISBURSAL_STATUS = ''Partially Disbursed'' and a.CURRENT_STATUS = ''NORMAL'' THEN a.loan_no END),0) AS pemi_normal_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' and b.DISBURSAL_STATUS = ''Partially Disbursed'' THEN lps.total_pos_amt  END),0) AS pemi_normal_customer_pos,
	COALESCE(COUNT( CASE WHEN b.DISBURSAL_STATUS = ''Partially Disbursed'' and a.CURRENT_STATUS = ''STABLE'' THEN a.loan_no END),0) AS pemi_stable_customer_count,
	COALESCE(SUM( CASE WHEN a.CURRENT_STATUS = ''STABLE'' and b.DISBURSAL_STATUS = ''Partially Disbursed'' THEN lps.total_pos_amt  END),0) AS pemi_stable_customer_pos,	
	COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Unpaid''  THEN a.loan_no END),0) AS unpaid_customer_count,
	COALESCE(SUM( CASE WHEN a.PAID_STATUS = ''Unpaid''  THEN lps.total_pos_amt  END),0) AS unpaid_customer_pos,	
	COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Paid''  THEN a.loan_no END),0) AS paid_customer_count,
	COALESCE(SUM( CASE WHEN a.PAID_STATUS = ''Paid''  THEN lps.total_pos_amt  END),0) AS paid_customer_pos,
	COALESCE(SUM( CASE WHEN a.OP_DPD != 0 and b.DPD = 0 THEN lps.total_pos_amt  END),0)  AS AS_ON_DATE_NORMAL, 
	CASE WHEN TOTAL_POS_AMOUNT = 0 then 0
	ELSE 
	(COALESCE(SUM( CASE WHEN a.OP_DPD > 0 and b.DPD = 0 THEN lps.total_pos_amt  END),0)) * 100/TOTAL_POS_AMOUNT END AS NORMALIZATION_PERCENT,
CASE WHEN TOTAL_LOAN_COUNT = 0 then 0 
ELSE  
(paid_customer_count*100)/TOTAL_LOAN_COUNT END  AS RESOLUTION_PAID_COUNT,
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Paid'' and a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END),0) AS AFFORDABLE_PAID_COUNT,
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Unpaid'' and a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END),0) AS AFFORDABLE_UNPAID_COUNT,
COALESCE(COUNT( CASE WHEN a.VERTICAL = ''AFFORDABLE''  THEN a.loan_no END),0) AS AFFORDABLE_GRAND_TOTAL_COUNT,
COALESCE(
    COUNT( CASE WHEN a.PAID_STATUS = ''Paid'' AND a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END) * 100.0 /
    NULLIF(COUNT( CASE WHEN a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END), 0),0) AS AFFORDABLE_RESOLUTION_PERCENT,
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' and a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END),0) AS AFFORDABLE_NORMAL_COUNT,
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''STABLE'' and a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no  END),0) AS AFFORDABLE_STABLE_COUNT, 
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.VERTICAL = ''AFFORDABLE'' THEN a.loan_no END),0) AS AFFORDABLE_ROLLFORWARD_COUNT, 
COALESCE(COUNT( CASE WHEN a.STATUS = ''Cheque in transit'' and a.VERTICAL = ''AFFORDABLE''   THEN a.loan_no END),0) AS AFFORDABLE_CHEQUE_IN_TRANSIT_COUNT, 
COALESCE(COUNT( CASE WHEN a.WRITEOFF_LOAN = 1  THEN a.loan_no END),0) AS WRITEOFF_TOTAL_COUNT,
COALESCE(SUM( CASE WHEN a.WRITEOFF_LOAN = 1  THEN lps.total_pos_amt  END),0) AS WRITEOFF_TOTAL_POS,
NULL AS AFS_CLOSED_COUNT,
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1  THEN a.loan_no END),0) AS AFS_TOTAL_COUNT,
COALESCE(SUM( CASE WHEN a.AFS_LOAN = 1  THEN lps.total_pos_amt  END),0) AS AFS_TOTAL_POS,
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''NORMAL''   THEN a.loan_no END),0) AS AFS_NORMAL_COUNT, 
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''STABLE''  THEN a.loan_no END),0) AS AFS_CLEARANCE_COUNT, 
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''STABLE''  THEN a.loan_no END),0) AS AFS_STABLE_COUNT, 
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''RTD''  THEN a.loan_no END),0) AS AFS_RTD_COUNT,  
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''ROLLBACK''  THEN a.loan_no END),0) AS AFS_ROLLBACK_COUNT,  
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.CURRENT_STATUS = ''ROLLFORWARD''  THEN a.loan_no END),0) AS AFS_ROLLFORWARD_COUNT,  
COALESCE(COUNT( CASE WHEN a.AFS_LOAN = 1 and a.STATUS = ''Cheque in transit''   THEN a.loan_no END),0) AS AFS_CHEQUE_IN_TRANSIT_COUNT, 
CASE WHEN AFS_TOTAL_COUNT = 0 then 0
	ELSE 
	(AFS_CLEARANCE_COUNT + AFS_NORMAL_COUNT + AFS_ROLLBACK_COUNT + AFS_STABLE_COUNT + AFS_RTD_COUNT ) * 100 /total_loan_count END AS AFS_RESOLUTION_PERCENT,
COALESCE(COUNT( CASE WHEN (UPPER(a.CURRENT_STATUS) = ''ROLLFORWARD'' AND UPPER(d.GROSS_STATUS) = ''Bounced'' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_rollforward_count,
COALESCE(COUNT( CASE WHEN UPPER(a.CURRENT_STATUS) = ''ROLLFORWARD'' AND UPPER(d.GROSS_STATUS) = ''Bounced'' and b.DPD > 90  THEN a.loan_no END),0) AS bouncing_90plus_rollforward_count,
COALESCE(COUNT( CASE WHEN (UPPER(a.STATUS) = ''Cheque in transit'' AND UPPER(d.GROSS_STATUS) = ''Bounced'' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_cheque_in_transit_count,
COALESCE(COUNT( CASE WHEN (a.PAID_STATUS = ''Paid'' AND UPPER(d.GROSS_STATUS) = ''Bounced'' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_paid_count,
COALESCE(COUNT( CASE WHEN (a.CURRENT_STATUS= ''STABLE'' AND UPPER(d.GROSS_STATUS) = ''Bounced'' and (b.DPD > 0 and b.DPD <= 90))  THEN a.loan_no END),0) AS bouncing_1_90_stable_count,	
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Paid'' and lps.total_pos_amt >= 2500000 THEN a.loan_no END),0) AS GREATER_THAN_25_LAC_POS_PAID_CASES, 
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Unpaid'' and lps.total_pos_amt >= 2500000 THEN a.loan_no END),0) AS GREATER_THAN_25_LAC_POS_UNPAID_CASES,  
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Paid'' and b.DPD > 0 and a.OP_DPD > 0 and a.PENAL_AMOUNT_OUTSTANDING > 0 THEN a.loan_no END),0) AS TOTAL_PENAL_RECEIVED_LOAN_COUNT, 
COALESCE(COUNT( CASE WHEN a.PAID_STATUS = ''Paid'' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.loan_no END),0) AS Fully_Paid_Loans_DPD_0_AND_6_Plus_Instalments_Count, 
COALESCE(SUM( CASE WHEN a.PAID_STATUS = ''Paid'' and b.DPD = 0 and  a.REMAINING_TENURE >= 6 THEN a.PENAL_AMOUNT_OUTSTANDING END)/10000000,0) AS Penal_Outstanding_DPD_0_Fully_Paid_AND_6_Plus_Instalments, 
COALESCE(COUNT( CASE WHEN a.MORATORIUM = 1  THEN a.loan_no  END),0) AS TOTAL_MORATORIUM_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1  THEN lps.total_pos_amt  END),0) AS TOTAL_MORATORIUM_POS, 
COALESCE(COUNT( CASE WHEN a.MORATORIUM = 1 and a.PAID_STATUS = ''Unpaid'' THEN a.loan_no END),0) AS UNPAID_MORATORIUM_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.PAID_STATUS = ''Unpaid'' THEN lps.total_pos_amt  END),0) AS UNPAID_MORATORIUM_POS, 
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''NORMAL'' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_NORMAL_COUNT,  
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = ''NORMAL'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_NORMAL_POS, 
COALESCE(COUNT( CASE WHEN a.MORATORIUM = 1 and UPPER(d.GROSS_STATUS) = ''REALIZED'' AND  UPPER(d.NET_STATUS) = ''PASS'' and b.DPD = 0 and a.OP_DPD = 0 THEN a.loan_no END),0) AS MORATORIUM_MIS_CLEARANCE_MARK_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and UPPER(d.GROSS_STATUS) = ''REALIZED'' AND  UPPER(d.NET_STATUS) = ''PASS'' and b.DPD = 0 and a.OP_DPD = 0 THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_CLEARANCE_MARK_POS, 
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''STABLE'' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_STABLE_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = ''STABLE'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_STABLE_POS, 
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLFORWARD'' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_ROLLFORWARD_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = ''ROLLFORWARD'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_ROLLFORWARD_POS,
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''ROLLBACK'' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_ROLLBACK_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = ''ROLLBACK'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_ROLLBACK_POS,
COALESCE(COUNT( CASE WHEN a.CURRENT_STATUS = ''RTD'' and a.MORATORIUM = 1 THEN a.loan_no END),0) AS MORATORIUM_MIS_RTD_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.CURRENT_STATUS = ''RTD'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_RTD_POS,
 COALESCE(COUNT( CASE WHEN a.STATUS = ''Cheque in transit'' and a.MORATORIUM = 1   THEN a.loan_no END),0) AS MORATORIUM_MIS_CHQ_IN_TRANSIT_COUNT, 
COALESCE(SUM( CASE WHEN a.MORATORIUM = 1 and a.STATUS = ''Cheque in transit'' THEN lps.total_pos_amt  END),0) AS MORATORIUM_MIS_CHQ_IN_TRANSIT_POS, 
CASE WHEN TOTAL_MORATORIUM_COUNT = 0 then 0
	ELSE 
	(MORATORIUM_MIS_CLEARANCE_MARK_COUNT + MORATORIUM_MIS_NORMAL_COUNT + MORATORIUM_MIS_ROLLBACK_COUNT + MORATORIUM_MIS_STABLE_COUNT + MORATORIUM_MIS_RTD_COUNT ) * 100 /TOTAL_MORATORIUM_COUNT END AS MORATORIUM_MIS_RESOLUTION_COUNT,
	CASE WHEN TOTAL_MORATORIUM_POS = 0 then 0
	ELSE 
	(MORATORIUM_MIS_CLEARANCE_MARK_POS + MORATORIUM_MIS_NORMAL_POS + MORATORIUM_MIS_ROLLBACK_POS + MORATORIUM_MIS_STABLE_POS + MORATORIUM_MIS_RTD_POS ) * 100 /TOTAL_MORATORIUM_POS END AS MORATORIUM_MIS_RESOLUTION_POS 
FROM (select * from DISHA_MART_ANALYTICS.COLLECTION_MART.DELINQUENCY_MART WHERE TO_DATE(start_timestamp) <= TO_DATE(:RUN_DATE) 
  AND (TO_DATE(end_timestamp) > TO_DATE(:RUN_DATE) OR TO_DATE(end_timestamp) IS NULL)
)  a
