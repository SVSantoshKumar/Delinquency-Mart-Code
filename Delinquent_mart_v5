CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.DELIQUENCY_MART_V5_PREFINAL 
(
LOAN_NO VARCHAR(255),
CUSTOMER_ID VARCHAR(255),
MORATORIUM INTEGER,
CHEQUE_IN_TRANSIT_AMT FLOAT,
CHEQUE_IN_TRANSIT_COUNT FLOAT,
OVERDUE_PRINCIPAL FLOAT,
OVERDUE_INTEREST FLOAT,
TOTAL_DUE FLOAT,
REMAINING_TENURE FLOAT,
PENAL_AMOUNT_OUTSTANDING FLOAT,
NPA_LOAN VARCHAR(255),
OP_DPD VARCHAR(255),
COLLX_BKT VARCHAR(255),
CYCLE VARCHAR(255),
CURRENT_DPD_SCALE VARCHAR(255),
OP_DPD_SCALE VARCHAR(255),
CURRENT_STATUS VARCHAR(255),
STATUS VARCHAR(255),
PAID_STATUS VARCHAR(255),
BUSINESS_DATE DATE,
CYCLE_DATE VARCHAR(255),
ON_OFF_BOOK VARCHAR(255),
INSTALLMENT_MODE VARCHAR(255),
LOAN_SANCTION_DATE DATE,
NET_LTV FLOAT,
EMI_OVERDUE_AMOUNT FLOAT,
ROID VARCHAR(255),
BUSINESS_STATE VARCHAR(255),
VERTICAL VARCHAR(255),
LAST_RECEIPT_AMOUNT  FLOAT,
LAST_RECEIVED_DATE_KNOCKOFF_DATE DATE,
BRANCH_ID INTEGER,
BRANCH_NAME VARCHAR(255),
BRANCH_STATE VARCHAR(255),
PRODUCT_ID INTEGER,
PRODUCT_CATEGORY VARCHAR(255),
PRODUCT_NAME VARCHAR(255),
COLLECTION_AGENT_EMP_ID VARCHAR(255),
COLLECTION_RESPONSIBILITY VARCHAR(255),
EXECUTIVE_CATEGORY VARCHAR(255),
TEAM VARCHAR(255),
TL_EMP_ID VARCHAR(255),
TL VARCHAR(255),
TL_NPL VARCHAR(255),
ACM_EMP_ID VARCHAR(255),
ACM VARCHAR(255),
SH_NPL VARCHAR(255),
ZH_EMP_ID VARCHAR(255),
COLL_ZH VARCHAR(255),
AFFORDABLE_ACM VARCHAR(255),
AFFORDABLE_ZH VARCHAR(255),
NH_EMP_ID VARCHAR(255),
NH VARCHAR(255),
BH_EMP_ID VARCHAR(255),
BH VARCHAR(255),
EXTRACT_DATE VARCHAR(255)
)
AS 
SELECT 
			TRIM(CAST(cd.LOAN_NO AS VARCHAR)),
			TRIM(lad.CUST_ID_FLEX),
			cd.MORATORIUM,
			cd.CHEQUE_IN_TRANSIT_AMT,
			cd.CHEQUE_IN_TRANSIT_COUNT,
			cd.OVERDUE_PRIN,
			cd.OVERDUE_INTEREST,
			cd.TOTAL_DUE,
			(cd.TOTAL_NO_OF_INSTL - cd.TOTAL_BILLED_INSTL_NO) AS REMAINING_TENURE,
			(cd.LPP + cd.PRE_EMI + cd.CBC_DUE + cd.OTHER_CHARGES_DUE) AS PENAL_AMOUNT_OUTSTANDING,
			CASE 
			WHEN laad.FLG_ACCR_STATUS = ''S'' then ''NPA''
			ELSE ''NORMAL'' end as NPA_LOAN,
			ld.OP_DPD AS OP_DPD,
			CASE 
			  WHEN ld.OP_DPD = 0 THEN ''A:0-0''
			  WHEN ld.OP_DPD >= 1 AND ld.OP_DPD <= 30 THEN ''B:1-30''
			  WHEN ld.OP_DPD >= 31 AND ld.OP_DPD <= 60 THEN ''C:31-60''
			  WHEN ld.OP_DPD >= 61 AND ld.OP_DPD <= 90 THEN ''D:61-90''
			  WHEN ld.OP_DPD >= 91 AND ld.OP_DPD <= 120 THEN ''E:91-120''
			  WHEN ld.OP_DPD >= 121 AND ld.OP_DPD <= 180 THEN ''F:121-180''
			  WHEN ld.OP_DPD > 180 THEN ''G:180''
			END AS COLLX_BKT,
			CASE 
			  WHEN ld.OP_DPD != 0 THEN ''Opening Allocation''
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, ''YYYY-MM-DD'')) = 5 THEN ''5th Cycle''
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, ''YYYY-MM-DD'')) = 10 THEN ''10th Cycle''
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, ''YYYY-MM-DD'')) = 15 THEN ''15th Cycle''
			  ELSE ''NA''
			END AS Cycle,
			CASE 
				WHEN cd.DPD = 0 THEN ''A:0-0''
				WHEN cd.DPD >= 1 AND  	cd.DPD <= 30 THEN ''B:1-30''
				WHEN cd.DPD >= 31 AND 	cd.DPD <= 60 THEN ''C:31-60''
				WHEN cd.DPD >= 61 AND 	cd.DPD <= 90 THEN ''D:61-90''
				WHEN cd.DPD >= 91 AND 	cd.DPD <= 120 THEN ''E:91-120''
				WHEN cd.DPD >= 121 AND cd.DPD <= 180 THEN ''F:121-180''
				WHEN cd.DPD > 180 THEN ''G:180''		
		END AS CURRENT_DPD_SCALE,
			CASE 
			  WHEN npa_check.CUST_TAG_STATUS = ''linked loan NPA'' THEN ''linked loan NPA''
			  WHEN npa_check.CUST_TAG_STATUS = ''NPA'' THEN ''NPA''
			  ELSE CURRENT_DPD_SCALE
			END AS OP_DPD_SCALE,
			cs.CURRENT_STATUS,
			CASE WHEN cs.CURRENT_STATUS = ''ROLLFORWARD'' and TRY_TO_NUMBER(cd.CHEQUE_IN_TRANSIT_COUNT) <> 0 then ''Cheque in transit''
			ELSE cs.CURRENT_STATUS END as STATUS,
			CASE WHEN STATUS IN (''ROLLFORWARD'',''Cheque in transit'') then ''Unpaid''
			ELSE ''Paid'' END AS PAID_STATUS,
			DATEADD(DAY,-1,TRY_TO_DATE(cd.EXTRACTED_DATE, ''YYYY-MM-DD'')) AS BUSINESS_DATE,
			CASE 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,''YYYY-MM-DD'')) = 5 THEN 5 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,''YYYY-MM-DD'')) = 10 THEN 10 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,''YYYY-MM-DD'')) = 15 THEN 15 
			END AS CYCLE_DATE,
			CASE 
			WHEN laae.POOL_NAME IS NULL then ''ON-BOOK''
			WHEN laae.POOL_NAME like ''%PTC%'' then ''PTC''
			ELSE ''OFF-BOOK''
			END AS ON_OFF_BOOK,
			--bhcax_agg.TOTAL_COLLATERAL_VALUE,
			--CASE WHEN UPPER(cd.DISBURSAL_STATUS) = ''FULLY DISBURSED'' THEN ''EMI'' ELSE ''PEMI'' END AS EMI_PEMI,   
			lac.repayment_mode__c AS INSTALLMENT_MODE, 
			lad.LOAN_SANCTION_DATE,
			max_pending_emi_per_cust.NET_LTV AS NET_LTV,
			(cd.TOTAL_DUE + cd.PRE_EMI) AS EMI_OVERDUE_AMOUNT,
			ro_check.EMPLOYEE_ID AS ROID,
			shm.business_state,
			CASE 
				WHEN shm.business_state like ''%AFFLUENT%'' then ''AFFLUENT''
				WHEN shm.business_state like ''%MSME%'' then ''MSME''
				WHEN shm.business_state like ''%AFFORDABLE%'' then ''AFFORDABLE''
				WHEN shm.business_state like ''%APF%'' then ''APF''		
				WHEN shm.business_state like ''%HIG%'' then ''HIG/MIG''
			ELSE ''RETAIL''		END AS VERTICAL,
			cd.LAST_RECEIPT_AMOUNT,
			cd.LAST_RECEIVED_DATE_KNOCKOFF_DATE,
			bd.branch_lms_code,
			cd.loan_branch,
			cd.state,	
			LAAD.COD_PROD,
			pm.PRODUCT_CATEGORY,
			pm.product_name,
			ch.EMP_ID,
			ch.COLLECTION_RESPONSIBILITY,
			ch.EXECUTIVE_CATEGORY,
			ch.TEAM,
			ch.TL_EMP_ID,
			ch.TL,
			ch.TL_NPL,
			ch.ACM_EMP_ID,
			ch.ACM,
			ch.SH_NPL,
			ch.ZH_EMP_ID,
			ch.Coll_ZH,
			ch.Affordable_ACM,
			ch.Affordable_ZH,
			ch.NH_EMP_ID,
			ch.NH,
			ch.BH_EMP_ID,
			ch.BH,
			ch.Extract_Date
			FROM DISHA_MART_ANALYTICS.COLLECTION_MART.temp_deduped_cd cd
		LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.npa_check ON TRIM(cd.LOAN_NO) = TRIM(npa_check.LOAN_NO)
        LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.ld ld ON TRIM(cd.LOAN_NO) = TRIM(ld.LOAN_NO) and cd.EXTRACTED_DATE = ld.EXTRACTED_DATE
        LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.current_status_cte cs ON cd.LOAN_NO = cs.LOAN_NO	AND cd.EXTRACTED_DATE = cs.EXTRACTED_DATE
     	LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.ro_check ON TRIM(cd.LOAN_NO) = TRIM(ro_check.loan_no)  
        LEFT JOIN DISHA_L1_HARMONIZED.FLEX_LMS.LN_ACCT_ATTRIBUTES_EXT laae ON TRIM(cd.LOAN_NO) = TRIM(laae.COD_ACCT_NO) and laae.activation_flag = 1
		LEFT JOIN DISHA_L1_HARMONIZED.FLEX_LMS.LN_ACCT_DTLS laad ON TRIM(cd.LOAN_NO) = TRIM(laad.cod_acct_no) and laad.activation_flag = 1
		--LEFT JOIN bhcax_agg ON TRIM(cd.LOAN_NO) = TRIM(bhcax_agg.COD_ACCT_NO)
        LEFT JOIN DISHA_L1_HARMONIZED.SFDC_LOS.loan_application__c lac ON TRIM(cd.LOAN_NO) = TRIM(lac.loan_application_id__c) and lac.activation_flag = 1
		LEFT JOIN DISHA_L2_CURATED.BASE_HARDCODE.coll_hierarchy ch ON TRIM(cd.LOAN_NO) = TRIM(ch.NEW_LOAN_NO) and TRY_TO_DATE(cd.EXTRACTED_DATE, ''YYYY-MM-DD'') = TO_DATE(ch.extract_date,''DD-MM-YYYY'')
		LEFT JOIN (SELECT * FROM DISHA_MART_ANALYTICS.SALES_CREDIT_MART.SALES_HIERARCHY_MART where CURRENT_FLAG = ''TRUE''  ) SHM ON 
		TRIM(ro_check.EMPLOYEE_ID)=TRIM(SHM.EMPLOYEE_ID)    
		LEFT JOIN DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS lad 
