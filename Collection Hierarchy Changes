CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.ch_dedup AS (
    SELECT *
    FROM (
        SELECT
				*,
            ROW_NUMBER() OVER (
                PARTITION BY NEW_LOAN_NO, EXTRACT_DT
                ORDER BY EXTRACT_DT DESC
            ) AS rn
        FROM DISHA_MART_ANALYTICS.COLLECTION_MART.ch_union_raw
    )
    WHERE rn = 1
);


CREATE OR REPLACE TEMPORARY TABLE DISHA_MART_ANALYTICS.COLLECTION_MART.ch_effective AS (
    SELECT
       *,
        CASE
            WHEN EXTRACT_DT <= '2025-09-30'
                THEN DATE_TRUNC('MONTH', EXTRACT_DT) + INTERVAL '1 MONTH' - INTERVAL '1 DAY'
            ELSE EXTRACT_DT
        END AS EFFECTIVE_EXTRACT_DATE
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.ch_dedup
);

select * from DISHA_MART_ANALYTICS.COLLECTION_MART.ch_effective where EXTRACT_DT = '2025-10-11'

create or replace TEMPORARY table DISHA_MART_ANALYTICS.COLLECTION_MART.ch_intervals AS (
    SELECT
        *,
        LEAD(EFFECTIVE_EXTRACT_DATE) OVER (
            PARTITION BY NEW_LOAN_NO
            ORDER BY EFFECTIVE_EXTRACT_DATE
        ) AS NEXT_EFFECTIVE_EXTRACT_DATE
    FROM DISHA_MART_ANALYTICS.COLLECTION_MART.ch_effective
);

select * from DISHA_MART_ANALYTICS.COLLECTION_MART.ch_intervals  limit 1000

SELECT
    TRIM(CAST(cd.LOAN_NO AS VARCHAR)) AS LOAN_NO,
    cd.MORATORIUM,
    ch.EMP_ID_CLEAN AS EMP_ID,
    ch.COLLECTION_RESPONSIBILITY,
    ch.EFFECTIVE_EXTRACT_DATE AS EFFECTIVE_DATE_MAPPED
FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST cd
LEFT JOIN DISHA_MART_ANALYTICS.COLLECTION_MART.ch_intervals ch
    ON TRIM(cd.LOAN_NO) = TRIM(ch.NEW_LOAN_NO)
    AND TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD') >= ch.EFFECTIVE_EXTRACT_DATE
    AND (
        TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD') < ch.NEXT_EFFECTIVE_EXTRACT_DATE
        OR ch.NEXT_EFFECTIVE_EXTRACT_DATE IS NULL
    ) where cd.extracted_date = '2025-09-23' limit 10000;



