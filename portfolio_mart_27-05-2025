CREATE OR REPLACE TEMP TABLE npa_check AS  
SELECT 
    lad.CUST_ID_FLEX,
    MIN(CAST(cd.LOAN_NO AS VARCHAR)) AS LOAN_NO,  -- Choose one representative loan
    MAX(CASE WHEN cd.DPD >= 91 THEN 1 ELSE 0 END) AS IS_NPA_CUST,
    MAX(CASE WHEN cd.DPD = 0 THEN 1 ELSE 0 END) AS HAS_ZERO_DPD,
    CASE 
        WHEN MAX(CASE WHEN cd.DPD >= 91 THEN 1 ELSE 0 END) = 1 
             AND MAX(CASE WHEN cd.DPD = 0 THEN 1 ELSE 0 END) = 1 THEN 'linked loan NPA'
        WHEN MAX(CASE WHEN cd.DPD >= 91 THEN 1 ELSE 0 END) = 1 THEN 'NPA'
        ELSE 'NORMAL'
    END AS CUST_TAG_STATUS
FROM deduped_cd cd
LEFT JOIN DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS lad 
    ON TRIM(CAST(cd.LOAN_NO AS VARCHAR)) = TRIM(lad.LOAN_NO)
WHERE cd.EXTRACTED_DATE = LAST_DAY(TRY_TO_DATE(EXTRACTED_DATE, 'YYYY-MM-DD')) 
  AND lad.activation_flag = 1 
GROUP BY lad.CUST_ID_FLEX;


CREATE OR REPLACE TEMPORARY TABLE ro_check AS 
			SELECT 
			loan_no,
				EMPLOYEE_ID
			FROM (
				SELECT 
					ld.loan_no,
					e.EMPLOYEE_ID
				FROM disha_l2_curated.base_model_data.loan_account_details ld
				LEFT JOIN disha_l2_curated.base_model_data.loan_application_details_trans la
					ON TRIM(la.loan_application_idv) = TRIM(ld.loan_no)
				LEFT JOIN disha_l2_curated.base_model_data.employee_details e
					ON CAST(e.UNIQUE_SYS_ID AS VARCHAR) = CAST(la.RO_ID AS VARCHAR)
				WHERE ld.activation_flag = 1
				AND la.loan_application_idv IS NOT NULL
				AND la.activation_flag = 1
				AND e.activation_flag = 1
			);



 CREATE OR REPLACE TEMPORARY TABLE max_pending_emi_per_cust AS 
					SELECT 
						lad.CUST_ID_FLEX,
						cd.loan_no,
						MAX(cd.TOTAL_NO_OF_INSTL - cd.TOTAL_BILLED_INSTL_NO) AS NET_LTV
						FROM deduped_cd cd
						LEFT JOIN DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS lad 
						ON TRIM(CAST(cd.LOAN_NO AS VARCHAR)) = TRIM(lad.LOAN_NO)
				--	WHERE TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD') >= '2025-02-27' AND TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD') <= '2025-03-31'
					GROUP BY lad.CUST_ID_FLEX , cd.loan_no;




CREATE OR REPLACE TEMPORARY TABLE customers_with_mixed_dpd AS
SELECT 
  lad.CUST_ID_FLEX AS CUSTOMER_CODE
FROM ld dpd
JOIN deduped_cd cd ON dpd.LOAN_NO = cd.LOAN_NO
LEFT JOIN DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS lad 
  ON TRIM(CAST(cd.LOAN_NO AS VARCHAR)) = TRIM(lad.LOAN_NO) and lad.activation_flag = 1
WHERE lad.CUST_ID_FLEX IS NOT NULL
GROUP BY lad.CUST_ID_FLEX
HAVING 
  MAX(CASE WHEN dpd.DPD > 0 THEN 1 ELSE 0 END) = 1 AND  MAX(CASE WHEN dpd.DPD = 0 THEN 1 ELSE 0 END) = 1;


CREATE OR REPLACE TEMPORARY TABLE current_status_cte AS 
  SELECT 
    cd.LOAN_NO,
    cd.DPD,
    cd.CHEQUE_IN_TRANSIT_COUNT,
    ld.OP_DPD,
	cd.EXTRACTED_DATE,
--	ld.BUSINESS_DATE,
    -- Compute CURRENT_STATUS
    CASE 
      WHEN ld.OP_DPD >= 91 AND cd.DPD < 91 AND cd.DPD > 0 THEN 'RTD'
      WHEN cd.DPD = 0 THEN 'NORMAL'
      WHEN cd.DPD = ld.OP_DPD THEN 'STABLE'
      WHEN cd.DPD < ld.OP_DPD THEN 'ROLLBACK'
      ELSE 'ROLLFORWARD'
    END AS CURRENT_STATUS
  FROM deduped_cd cd
LEFT JOIN ld ld ON cd.LOAN_NO = ld.LOAN_NO and cd.EXTRACTED_DATE = ld.EXTRACTED_DATE;
--LEFT JOIN ld ON cd.LOAN_NO = ld.LOAN_NO and cd.BUSINESS_DATE = ld.BUSINESS_DATE;


 CREATE OR REPLACE TEMPORARY TABLE bhcax_agg AS (
  SELECT 
    COD_ACCT_NO, 
    SUM(CAST(AMT_COLL_VALUE AS FLOAT)) AS TOTAL_COLLATERAL_VALUE
  FROM DISHA_L1_HARMONIZED.FLEX_LMS.BA_HO_COLL_ACCT_XREF
  WHERE activation_flag = 1
  GROUP BY COD_ACCT_NO
);


INSERT  INTO DISHA_MART_ANALYTICS.COLLECTION_MART.PORTFOLIO_MART (
			LOAN_NO,
			CUSTOMER_ID,
			UNIQUE_CUSTOMER,
			UNIQUE_CUSTOMER_FLAG_BUCKET,
			MORATORIUM,
			CHEQUE_IN_TRANSIT_AMT,
			CHEQUE_IN_TRANSIT_COUNT,
			--TOTAL_NO_OF_INSTL,
			BOOKING_DATE,
			OVERDUE_INTEREST,
			OVERDUE_PRIN,
			--TOTAL_BILLED_INSTL_NO,
			TOTAL_DUE,
			--TOTAL_RECEIV_INSTL,
			--OVERDUE_INSTL_COUNT,
			--CURRENT_MONTH_INSTLAMENT_DUE_DATE,
			LOAN_BRANCH,
			--STATE,
			REMAINING_TENURE,
			PENAL_AMOUNT_OUTSTANDING,
			NPA_LOAN,
			TOTAL_POS,
			--CR,
			DPD,
			OP_DPD,
			--MAR_XX_DPD,
			COLLX_BKT,
			--BUCKET_HEAD,
			CYCLE,
			CURRENT_DPD_SCALE,
			OP_DPD_SCALE,
			CURRENT_STATUS,
			STATUS,
			PAID_STATUS,
			--RF_CASES,
			--FILE_EXTRACT_DATE,
			BUSINESS_DATE,
			CYCLE_DATE,
			ON_OFF_BOOK,
			--EMI_PATTERN,
			ASSET_COLLATERAL_VALUE,
			--DISBURSAL_STATUS,
			--LOAN_STATUS,
			EMI_PEMI,
			INSTALLMENT_MODE,
			LOAN_SANCTION_DATE,
			--LAST_DISBURMENT_DATE,
			NET_LTV,
			EMI_OVERDUE_AMOUNT,
			ROID,
			LAST_RECEIPT_AMOUNT ,
			LAST_RECEIVED_DATE_KNOCKOFF_DATE,
			COLLECTION_AGENT_EMP_ID,
			COLLECTION_RESPONSIBILITY,
			EXECUTIVE_CATEGORY,
			TEAM,
			TL_EMP_ID,
			TL,
			TL_NPL,
			ACM_EMP_ID,
			ACM,
			SH_NPL,
			ZH_EMP_ID,
			Coll_ZH,
			Affordable_ACM,
			Affordable_ZH,
			NH_EMP_ID,
			NH,
			BH_EMP_ID,
			BH,
			Extract_Date
				)
		SELECT 
			TRIM(CAST(cd.LOAN_NO AS VARCHAR)),
			TRIM(lad.CUST_ID_FLEX),
			CASE 
				 WHEN cust_loan_check.loan_count = 1 THEN '1'
				 ELSE '0'
			END AS UNIQUE_CUSTOMER,
			 CASE 
			  WHEN MAX(cd.DPD) = 0 THEN 'a:0-0'
			  WHEN MAX(cd.DPD) >= 1 AND MAX(cd.DPD) <= 30 THEN 'b:1-30'
			  WHEN MAX(cd.DPD) >= 31 AND MAX(cd.DPD) <= 60 THEN 'c:31-60'
			  WHEN MAX(cd.DPD) >= 61 AND MAX(cd.DPD) <= 90 THEN 'd:61-90'
			  WHEN MAX(cd.DPD) >= 91 AND MAX(cd.DPD) <= 120 THEN 'e:91-120'
			  WHEN MAX(cd.DPD) >= 121 AND MAX(cd.DPD) <= 180 THEN 'f:121-180'
			  WHEN MAX(cd.DPD) > 180 THEN 'g>180'
			END AS UNIQUE_CUSTOMER_FLAG_BUCKET,
			cd.MORATORIUM,
			cd.CHEQUE_IN_TRANSIT_AMT,
			cd.CHEQUE_IN_TRANSIT_COUNT,
			--cd.TOTAL_NO_OF_INSTL,
			cd.BOOKING_DATE,
			cd.OVERDUE_INTEREST,
			cd.OVERDUE_PRIN,
			--cd.TOTAL_BILLED_INSTL_NO,
			cd.TOTAL_DUE,
			--cd.TOTAL_RECEIV_INSTL,
			--cd.OVERDUE_INSTL_COUNT,
			--cd.CURRENT_MONTH_INSTLAMENT_DUE_DATE,
			cd.LOAN_BRANCH,
			--cd.STATE,
			(cd.TOTAL_NO_OF_INSTL - cd.TOTAL_BILLED_INSTL_NO) AS REMAINING_TENURE,
			--NULL AS GROSS_BOUNCE,
			--NULL AS NET_BOUNCE,		
			--NULL AS ALLOCATEDAMOUNT,
			(cd.LPP + cd.PRE_EMI + cd.CBC_DUE + cd.OTHER_CHARGES_DUE) AS PENAL_AMOUNT_OUTSTANDING,
			CASE 
			WHEN laad.FLG_ACCR_STATUS = 'S' then 'NPA'
			ELSE 'NORMAL' end as NPA_LOAN,
			cd.TOTAL_POS,
			--(cd.TOTAL_POS/10000000) AS CR,
			cd.DPD,
			ld.OP_DPD AS OP_DPD,
			--march_dpd.MARCH_XX_DPD,
			CASE 
			  WHEN ld.OP_DPD = 0 THEN 'A:0-0'
			  WHEN ld.OP_DPD >= 1 AND ld.OP_DPD <= 30 THEN 'B:1-30'
			  WHEN ld.OP_DPD >= 31 AND ld.OP_DPD <= 60 THEN 'C:31-60'
			  WHEN ld.OP_DPD >= 61 AND ld.OP_DPD <= 90 THEN 'D:61-90'
			  WHEN ld.OP_DPD >= 91 AND ld.OP_DPD <= 120 THEN 'E:91-120'
			  WHEN ld.OP_DPD >= 121 AND ld.OP_DPD <= 180 THEN 'F:121-180'
			  WHEN ld.OP_DPD > 180 THEN 'G:180'
			END AS COLLX_BKT,
			--NULL AS BUCKET_HEAD,
			CASE 
			  WHEN ld.OP_DPD != 0 THEN 'Opening Allocation'
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, 'YYYY-MM-DD')) = 5 THEN '5th Cycle'
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, 'YYYY-MM-DD')) = 10 THEN '10th Cycle'
			  WHEN ld.OP_DPD = 0 AND DAY(TRY_TO_DATE(cd.LAST_EMI_DATE, 'YYYY-MM-DD')) = 15 THEN '15th Cycle'
			  ELSE 'NA'
			END AS Cycle,
			CASE 
			  WHEN ld.OP_DPD = 0 THEN 'A:0-0'
			  WHEN ld.OP_DPD >= 1 AND ld.OP_DPD <= 30 THEN 'B:1-30'
			  WHEN ld.OP_DPD >= 31 AND ld.OP_DPD <= 60 THEN 'C:31-60'
			  WHEN ld.OP_DPD >= 61 AND ld.OP_DPD <= 90 THEN 'D:61-90'
			  WHEN ld.OP_DPD >= 91 AND ld.OP_DPD <= 120 THEN 'E:91-120'
			  WHEN ld.OP_DPD >= 121 AND ld.OP_DPD <= 180 THEN 'F:121-180'
			  WHEN ld.OP_DPD > 180 THEN 'G:180'
			END AS CURRENT_DPD_SCALE,
			CASE 
			  WHEN npa_check.CUST_TAG_STATUS = 'linked loan NPA' THEN 'linked loan NPA'
			  WHEN npa_check.CUST_TAG_STATUS = 'NPA' THEN 'NPA'
			  ELSE CURRENT_DPD_SCALE
			END AS OP_DPD_SCALE,
			cs.CURRENT_STATUS,
			CASE WHEN cs.CURRENT_STATUS = 'ROLLFORWARD' and TRY_TO_NUMBER(cd.CHEQUE_IN_TRANSIT_COUNT) <> 0 then 'Cheque in transit'
			ELSE cs.CURRENT_STATUS END as STATUS,
			CASE WHEN STATUS IN ('ROLLFORWARD','Cheque in transit') then 'Unpaid'
			ELSE 'Paid' END AS PAID_STATUS,
			--CASE WHEN (ld.OP_DPD >= 91 AND cd.DPD > ld.OP_DPD) THEN 'YES' ELSE '' END AS RF_CASES,
			--TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD') AS EXTRACTED_DATE,
			DATEADD(DAY,-1,TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD')) AS BUSINESS_DATE,
			CASE 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,'YYYY-MM-DD')) = 5 THEN 5 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,'YYYY-MM-DD')) = 10 THEN 10 
			  WHEN DAY(TRY_TO_DATE(cd.LAST_EMI_DATE,'YYYY-MM-DD')) = 15 THEN 15 
			END AS CYCLE_DATE,
			CASE 
			WHEN laae.POOL_NAME IS NULL then 'ON-BOOK'
			WHEN laae.POOL_NAME like '%PTC%' then 'PTC'
			ELSE 'OFF-BOOK'
			END AS ON_OFF_BOOK,
			--'EPI' AS EMI_PATTERN,
			bhcax_agg.TOTAL_COLLATERAL_VALUE,
			--cd.DISBURSAL_STATUS,
			--cd.LOAN_STATUS,
			CASE WHEN UPPER(cd.DISBURSAL_STATUS) = 'FULLY DISBURSED' THEN 'EMI' ELSE 'PEMI' END AS EMI_PEMI,   
			lac.repayment_mode__c AS INSTALLMENT_MODE, 
			lad.LOAN_SANCTION_DATE,
			--lad.LAST_DISBURSAL_DATE,
			max_pending_emi_per_cust.NET_LTV AS NET_LTV,
			(cd.TOTAL_DUE + cd.PRE_EMI) AS EMI_OVERDUE_AMOUNT,
			ro_check.EMPLOYEE_ID AS ROID,
			cd.LAST_RECEIPT_AMOUNT,
			cd.LAST_RECEIVED_DATE_KNOCKOFF_DATE,
			ch.EMP_ID,
			ch.COLLECTION_RESPONSIBILITY,
			ch.EXECUTIVE_CATEGORY,
			ch.TEAM,
			ch.TL_EMP_ID,
			ch.TL,
			ch.TL_NPL,
			ch.ACM_EMP_ID,
			ch.ACM,
			ch.SH_NPL,
			ch.ZH_EMP_ID,
			ch.Coll_ZH,
			ch.Affordable_ACM,
			ch.Affordable_ZH,
			ch.NH_EMP_ID,
			ch.NH,
			ch.BH_EMP_ID,
			ch.BH,
			ch.Extract_Date
			FROM deduped_cd cd
		LEFT JOIN npa_check ON TRIM(cd.LOAN_NO) = TRIM(npa_check.LOAN_NO)
        LEFT JOIN ld ld ON TRIM(cd.LOAN_NO) = TRIM(ld.LOAN_NO) and cd.EXTRACTED_DATE = ld.EXTRACTED_DATE
        LEFT JOIN current_status_cte cs ON cd.LOAN_NO = cs.LOAN_NO	AND cd.EXTRACTED_DATE = cs.EXTRACTED_DATE
     	LEFT JOIN ro_check ON TRIM(cd.LOAN_NO) = TRIM(ro_check.loan_no)  
        LEFT JOIN DISHA_L1_HARMONIZED.FLEX_LMS.LN_ACCT_ATTRIBUTES_EXT laae ON TRIM(cd.LOAN_NO) = TRIM(laae.COD_ACCT_NO) and laae.activation_flag = 1
		LEFT JOIN DISHA_L1_HARMONIZED.FLEX_LMS.LN_ACCT_DTLS laad ON TRIM(cd.LOAN_NO) = TRIM(laad.cod_acct_no) and laad.activation_flag = 1
		LEFT JOIN bhcax_agg ON TRIM(cd.LOAN_NO) = TRIM(bhcax_agg.COD_ACCT_NO)
        LEFT JOIN DISHA_L1_HARMONIZED.SFDC_LOS.loan_application__c lac ON TRIM(cd.LOAN_NO) = TRIM(lac.loan_application_id__c) and lac.activation_flag = 1
		LEFT JOIN DISHA_L2_CURATED.BASE_HARDCODE.coll_hierarchy ch ON TRIM(cd.LOAN_NO) = TRIM(ch.NEW_LOAN_NO)         and DATE_TRUNC('MONTH', DATEADD(DAY,-1,TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD'))) =             DATE_TRUNC('MONTH',TO_DATE(ch.extract_date,'DD-MM-YYYY'))
        LEFT JOIN DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS lad 
        ON TRIM(CAST(cd.LOAN_NO AS VARCHAR)) = TRIM(lad.LOAN_NO) AND lad.activation_flag = 1
        LEFT JOIN cust_loan_check ON TRIM(cd.loan_no) = TRIM(cust_loan_check.loan_no)
        LEFT JOIN max_pending_emi_per_cust  ON TRIM(cd.loan_no) = TRIM(max_pending_emi_per_cust.loan_no)
       --LEFT JOIN march_dpd ON TRIM(cd.LOAN_NO) = TRIM(march_dpd.LOAN_NO) AND EXTRACT(YEAR FROM TRY_TO_DATE(cd.EXTRACTED_DATE, 'YYYY-MM-DD')) = march_dpd.DPD_YEAR
	WHERE 
		cd.DPD > 0 
		--OR (cd.DPD = 0 AND lad.CUST_ID_FLEX IN (SELECT CUSTOMER_CODE FROM customers_with_mixed_dpd))
		GROUP BY TRIM(cd.LOAN_NO),TRIM(lad.CUST_ID_FLEX),cust_loan_check.loan_count,
		cd.MORATORIUM,cd.CHEQUE_IN_TRANSIT_AMT,
		cd.CHEQUE_IN_TRANSIT_COUNT,BOOKING_DATE,
		cd.OVERDUE_INTEREST,cd.OVERDUE_PRIN,cd.TOTAL_NO_OF_INSTL,cd.TOTAL_BILLED_INSTL_NO,
		cd.TOTAL_DUE, 
		--cd.TOTAL_RECEIV_INSTL,cd.OVERDUE_INSTL_COUNT, cd.CURRENT_MONTH_INSTLAMENT_DUE_DATE,cd.STATE,
		cd.LOAN_BRANCH,cd.LPP, cd.PRE_EMI, cd.CBC_DUE,cd.OTHER_CHARGES_DUE,laad.FLG_ACCR_STATUS,cd.TOTAL_POS,cd.DPD,ld.OP_DPD,npa_check.CUST_TAG_STATUS,
		--march_dpd.MARCH_XX_DPD,
		cs.CURRENT_STATUS,
	laae.POOL_NAME,bhcax_agg.TOTAL_COLLATERAL_VALUE,cd.DISBURSAL_STATUS,cd.LOAN_STATUS, lac.repayment_mode__c,cd.LAST_EMI_DATE,cd.EXTRACTED_DATE,lac.repayment_mode__c,
	lad.LOAN_SANCTION_DATE,
	--lad.LAST_DISBURSAL_DATE,
