CREATE OR REPLACE TEMPORARY TABLE deduped_cd AS
SELECT *,
FROM (
  SELECT *,
    ROW_NUMBER() OVER (
      PARTITION BY LOAN_NO, EXTRACTED_DATE 
      ORDER BY LOAN_NO DESC -- or another column that can identify the latest version
    ) AS rn
  FROM DISHA_L2_CURATED.HISTORICAL_LOAD.COLL_DUELIST where TRY_TO_DATE(EXTRACTED_DATE, 'YYYY-MM-DD') >='2024-12-01' 
  and TRY_TO_DATE(EXTRACTED_DATE, 'YYYY-MM-DD') <= '2024-12-31'
  --AND TRY_TO_DATE(EXTRACTED_DATE, 'YYYY-MM-DD') <='2025-03-31'
) sub
WHERE rn = 1;


CREATE  OR REPLACE TEMP TABLE deduped_cd_with_bd AS
SELECT 
    *,
    TRY_TO_DATE(EXTRACTED_DATE, 'YYYY-MM-DD') - 1 AS BUSINESS_DATE
FROM deduped_cd;


CREATE  OR REPLACE TEMP TABLE business_with_prev_month_end AS
SELECT
    *,
    LAST_DAY(BUSINESS_DATE - INTERVAL '1 MONTH') AS PREV_MONTH_END
FROM deduped_cd_with_bd;


CREATE  OR REPLACE TEMP TABLE dpd_lookup AS
SELECT
    LOAN_NO,
    BUSINESS_DATE AS DPD_DATE,
    DPD AS DPD_FOR_DATE
FROM deduped_cd_with_bd;


CREATE  OR REPLACE TEMP TABLE ld AS
SELECT
    a.LOAN_NO,
    a.EXTRACTED_DATE,
    a.BUSINESS_DATE,
    a.DPD,
    a.PREV_MONTH_END,
    b.DPD_FOR_DATE AS OP_DPD
FROM business_with_prev_month_end a
LEFT JOIN dpd_lookup b
    ON a.LOAN_NO = b.LOAN_NO
   AND a.PREV_MONTH_END = b.DPD_DATE;


CREATE OR REPLACE TEMPORARY TABLE lad_deduped AS (
  SELECT *
  FROM (
    SELECT *
    FROM DISHA_L2_CURATED.BASE_MODEL_DATA.LOAN_ACCOUNT_DETAILS
    WHERE activation_flag = 1
    QUALIFY ROW_NUMBER() OVER (PARTITION BY loan_no ORDER BY dat_start DESC) = 1
  )
);

-- Step 2: Join deduped_cd with the deduped LAD table
CREATE OR REPLACE TEMPORARY TABLE cust_loan_check AS
SELECT 
  lad.CUST_ID_FLEX,
  cd.LOAN_NO,
  COUNT(DISTINCT cd.LOAN_NO) AS loan_count
FROM deduped_cd cd
LEFT JOIN lad_deduped lad 
  ON TRIM(CAST(cd.LOAN_NO AS VARCHAR)) = TRIM(lad.LOAN_NO)
GROUP BY lad.CUST_ID_FLEX, cd.LOAN_NO;


